  screens:
  - speaker: {fileID: 11400000, guid: d7d90acd337545242978d965e5b6e6f5, type: 2}
    dialog: Heeeeey!
    ScreenActions:
    - rid: 9079475098267418678
    - rid: 9079475089592287301
  - speaker: {fileID: 0}
    dialog: I see an annoying girl running toward me from the distance, waving her
      arms in the air like she's totally oblivious to any attention she might draw
      to herself.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">Wow.
    ScreenActions:
    - rid: 9079475089592287312
    - rid: 9079475098267418675
    - rid: 4972360475574796288
    - rid: 4972360390599770176
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">That's the first impression we're going to give our
      player?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">I can already tell that this vessel is hopeless.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">Welp, back to the drawing board...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">Oh! I've still got the other one lying around here
      somewhere.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: fdd5cfec9471d2f48a6134838a2b377b, type: 2}
    dialog: <font="glitchfont">Let me just-</font>
    ScreenActions: []
