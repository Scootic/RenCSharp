  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4972360184803622912
    - rid: 4972360184803622913
    - rid: 4972360184803622915
    - rid: 4972360184803622916
    - rid: 7856103185826971722
    - rid: 7856103185826971723
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}...'
    ScreenActions:
    - rid: 4972360184803622914
    - rid: 7856103185826971714
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}...?'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: It's time to get up, {mc}...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Huh, wha-?
    ScreenActions:
    - rid: 7856103185826971716
    - rid: 7856103185826971717
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Good morning, {mc}!
    ScreenActions:
    - rid: 7856103185826971718
    - rid: 7856103185826971719
    - rid: 7856103185826971720
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey... I'm the one waking <i>you</i> up this time!
    ScreenActions:
    - rid: 7856103185826971721
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: C'mon {mc}, let's go have breakfast!
    ScreenActions:
    - rid: 7856103185826971726
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 7856103185826971727
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Meh... I don't wanna get up...
    ScreenActions:
    - rid: 7856103185826971728
    - rid: 7856103185826971729
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Are you still tired-?
    ScreenActions:
    - rid: 7856103185826971730
    - rid: 7856103185826971731
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Did you have trouble falling asleep-?
    ScreenActions:
    - rid: 7856103185826971732
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Did someone attack you in the middle of the night so you still need more
      rest?!?
    ScreenActions:
    - rid: 7856103185826971733
    - rid: 7856103185826971734
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Nice exercise of your imagination, Sayori-
    ScreenActions:
    - rid: 7856103185826971735
    - rid: 7856103185826971736
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: But nah, I just don't feel like getting up.
    ScreenActions:
    - rid: 7856103185826971737
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 7856103185826971738
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Is it because Meeko's snuggled up next to you?
    ScreenActions:
    - rid: 7856103185826971739
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That's definitely part of it.
    ScreenActions:
    - rid: 7856103185826971740
    - rid: 7856103185826971741
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, you want me to get you breakfast in bed?
    ScreenActions:
    - rid: 7856103185826971742
    - rid: 7856103185826971743
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Nah, that'd probably wake up the dog and I don't really like eating in
      bed anyway.
    ScreenActions:
    - rid: 7856103185826971744
    - rid: 7856103185826971745
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Really? You don't like breakfast in bed?
    ScreenActions:
    - rid: 7856103185826971746
    - rid: 7856103185826971747
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yep. I've had-
    ScreenActions:
    - rid: 7856103185826971748
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Remember having...
    ScreenActions:
    - rid: 7856103185826971749
    - rid: 7856103185826971750
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Little crumbs and stuff in my bed after eating, that made it impossible
      to sleep.
    ScreenActions:
    - rid: 7856103185826971751
    - rid: 7856103185826971752
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah. Well...
    ScreenActions:
    - rid: 7856103613850189824
    - rid: 7856103613850189825
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Could you please get up now?
    ScreenActions:
    - rid: 7856103613850189826
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Natsuki's got something we need to help her with, right?
    ScreenActions:
    - rid: 7856103613850189827
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What time is it, anyway?
    ScreenActions:
    - rid: 7856103613850189828
    - rid: 7856103613850189829
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hmm...
    ScreenActions:
    - rid: 7856103613850189831
    - rid: 7856103613850189832
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: It's around 10, I think?
    ScreenActions:
    - rid: 7856103613850189833
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Haaahh...
    ScreenActions:
    - rid: 7856103613850189834
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Might as well get up.
    ScreenActions:
    - rid: 7856103613850189836
    - rid: 7856103613850189837
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: C'mon Meeko, bed time's over.
    ScreenActions:
    - rid: 7856103613850189838
  - speaker: {fileID: 11400000, guid: 491799c9d5b8c2649bb20546f506fa86, type: 2}
    dialog: '?'
    ScreenActions:
    - rid: 7856103613850189839
    - rid: 7856103613850189840
    - rid: 7856103613850189841
    - rid: 7856103613850189842
    - rid: 7856103613850189896
    - rid: 7856103613850189897
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 7856103613850189898
    - rid: 7856103613850189899
    - rid: 7856103613850189900
    - rid: 7856103613850189901
    - rid: 7856103613850189902
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori and {mc} order up some eggs and bread for breakfast.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: It doesn't take long to make or eat, so they're ready to head over to
      Jorrvaskr after fifteen minutes.
    ScreenActions:
    - rid: 7856103613850189903
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Alright, {mc}, let's go see what Natsuki has in store for us!
    ScreenActions:
    - rid: 7856103613850189904
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, sure.
    ScreenActions:
    - rid: 7856103613850189905
    - rid: 7856103613850189906
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 7856103658984308737
    - rid: 7856103658984308738
    - rid: 7856103658984308739
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Gh- it's like 10 and they're still not here?)
    ScreenActions:
    - rid: 7856103658984308740
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: '(I''m not exactly sure who I should be blaming this on: Sayori or {mc}...)'
    ScreenActions:
    - rid: 7856103658984308741
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Then again, them being late did give me time to go over what's planned
      for today with Vilkas.)
    ScreenActions:
    - rid: 7856103658984308795
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Natsuki! We're here!
    ScreenActions:
    - rid: 7856103658984308796
    - rid: 7856103658984308798
    - rid: 7856103658984308801
    - rid: 7856103658984308802
    - rid: 7856103658984308800
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Jeez, took you two long enough.
    ScreenActions:
    - rid: 7856103658984308803
    - rid: 7856103658984308804
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: So, so? What'd you need help with?
    ScreenActions:
    - rid: 7856103658984308805
    - rid: 7856103658984308806
    - rid: 7856103658984308809
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'I''ve got an important job for you two:'
    ScreenActions:
    - rid: 7856103658984308817
    - rid: 7856103658984308807
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: See, we've gotten a request from somebody to return a package to them.
    ScreenActions:
    - rid: 7856103658984308810
    - rid: 7856103658984308812
    - rid: 7856103658984308813
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Last I checked, the Companions weren't couriers, Natsuki.
    ScreenActions:
    - rid: 7856103658984308814
    - rid: 7856103658984308816
    - rid: 7856103658984308815
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, I knew that, you didn't let me finish.
    ScreenActions:
    - rid: 7856103658984308819
    - rid: 7856103658984308820
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Originally, the package was being delivered by a personal courier-
    ScreenActions:
    - rid: 7856103658984308825
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But, since it's a been a few days past the expected arrival time, it
      can be assumed they were ambushed.
    ScreenActions:
    - rid: 7856103658984308826
    - rid: 7856103658984308827
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It's your job to get it back from whoever stole it and get it back to
      its owner.
    ScreenActions:
    - rid: 7856103658984308828
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... And why are <i>we</i> the ones doing this?
    ScreenActions:
    - rid: 7856103658984308829
    - rid: 7856103658984308830
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: There's no shortage of able bodies here, and if it's really that important
      you could get Farkas to do it, or something.
    ScreenActions:
    - rid: 7856103658984308831
    - rid: 7856103658984308832
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Jeez, call my bluff, why don't ya...)
    ScreenActions:
    - rid: 7856103658984308833
    - rid: 7856103658984308834
    - rid: 7856103658984308835
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Farkas, Vilkas, and Aela are all busy with other stuff-
    ScreenActions:
    - rid: 7856103658984308836
    - rid: 7856103658984308837
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm working with Eorlund on my new armor, so I can't go either-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: And this job's got a crazy high payout; I doubt any of the whelps would
      be up to snuff.
    ScreenActions:
    - rid: 7856103658984308838
    - rid: 7856103658984308839
    - rid: 7856103658984308840
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So you're getting paid a massive amount of money to go make sure some
      random package is safe?
    ScreenActions:
    - rid: 8164893126226346051
    - rid: 8164893126226346052
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Isn't that really suspicious?
    ScreenActions:
    - rid: 8164893126051758082
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yep.
    ScreenActions:
    - rid: 8164893126226345984
    - rid: 8164893126226345985
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: See, we recently got a job from a guy who turned out to be Thalmor-
    ScreenActions:
    - rid: 8164893126226345986
    - rid: 8164893126226345987
    - rid: 8164893126226345988
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: He was after some dragon priest's mask, or whatever-
    ScreenActions:
    - rid: 8164893126226345989
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: So, I want you two to get out there and see what's really up with that
      package.
    ScreenActions:
    - rid: 8164893126226345990
    - rid: 8164893126226345991
    - rid: 8164893126226345992
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: If it turns out that there's nothing crazy going on, go ahead and make
      the delivery-
    ScreenActions:
    - rid: 8164893126226345993
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But, if the Thalmor are doing more crazy stuff, I figured that you might
      be able to know what's up, {mc}.
    ScreenActions:
    - rid: 8164893126226345994
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You've had an encounter with the Thalmor too, Natsuki?
    ScreenActions:
    - rid: 8164893126226345995
    - rid: 8164893126226345996
    - rid: 8164893126226345997
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, we dealt with the Dragon Priest Mask job yesterday-
    ScreenActions:
    - rid: 8164893126226346053
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Why, is there something major going on already, or something?
    ScreenActions:
    - rid: 8164893126226346054
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well, uh-
    ScreenActions:
    - rid: 8164893126226346055
    - rid: 8164893126226346056
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori explains Monika's, as well as her, and by extension {mc}'s, recent
      encounters with Thalmor activity.
    ScreenActions:
    - rid: 8164893126226346057
    - rid: 8164893126226346058
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: All the more reason we gotta get someone trustworthy on this-
    ScreenActions:
    - rid: 8164893126226346059
    - rid: 8164893126226346060
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: If those Thalmor really are as evil as you say, {mc}, we should beat
      the tar out of them before they get a chance.
    ScreenActions:
    - rid: 8164893126226346061
    - rid: 8164893126226346062
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 8164893126226346063
    - rid: 8164893126226346066
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: '{mc}? You good?'
    ScreenActions:
    - rid: 8164893126226346064
    - rid: 8164893126226346065
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hm?
    ScreenActions:
    - rid: 8164893126226346067
    - rid: 8164893126226346068
    - rid: 8164893126226346069
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sorry, I was just thinking.
    ScreenActions:
    - rid: 8164893126226346070
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: For as evil an organization the Thalmor are, and for as great a threat
      they are in the grand scheme of things-
    ScreenActions:
    - rid: 8164893126226346071
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: In the original game, they didn't really do too much.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: They were sort of this background threat that wasn't too in your face-
    ScreenActions:
    - rid: 8164893126226346072
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Especially compared to stuff like dragons coming back, vampires attacking
      towns, and cultists taking over an island-
    ScreenActions:
    - rid: 8164893126226346073
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'But since they weren''t the major focus, you couldn''t really do too
      much about them as a player:'
    ScreenActions:
    - rid: 8164893126226346074
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Just a few minor side-quests here or there that wouldn't affect the Thalmor
      as a whole.
    ScreenActions:
    - rid: 8164893126226346075
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So what's got them so riled up?
    ScreenActions:
    - rid: 8164893126226346076
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I dunno, maybe this place isn't as much of a game as you and Monika think-
    ScreenActions:
    - rid: 8164893126226346077
    - rid: 8164893126226346078
    - rid: 8164893126226346079
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Sure, we know about {Player}-
    ScreenActions:
    - rid: 8164893126226346082
    - rid: 8164893126226346083
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Who?)
    ScreenActions:
    - rid: 8164893126226346080
    - rid: 8164893126226346081
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But they could just as easily be some sort of ghost or magic-something-or-other-
    ScreenActions:
    - rid: 8164893126226346084
    - rid: 8164893126226346085
    - rid: 8164893126226346086
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893126226346087
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893126226346088
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893126226346092
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893126226346099
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: If I were a betting man, I'd say that the entity that brought us here
      is behind the Thalmor doing stuff.
    ScreenActions:
    - rid: 8164893126226346102
    - rid: 8164893126226346103
    - rid: 8164893126226346104
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'I already dealt with the main quest of the game, so there are only three
      world-altering threats left:'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The Volkihar clan of vampires, another dragonborn named Miraak, and...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, the Thalmor.
    ScreenActions:
    - rid: 8164893126226346105
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So I'm guessing that the entity chose to pit us against the most sophisticated
      threat-
    ScreenActions:
    - rid: 8164893126226346106
    - rid: 8164893126226346108
    - rid: 8164893126226346109
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: If that makes any sense.
    ScreenActions:
    - rid: 8164893126226346107
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I swear, if we meet up with Yuri and she tells us about some Thalmor
      trouble she's having...
    ScreenActions:
    - rid: 8164893126226346110
    - rid: 8164893126226346111
    - rid: 8164893126226346112
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 8164893126226346113
    - rid: 8164893126226346114
    - rid: 8164893126226346115
    - rid: 8164893126226346116
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Look, I don't really like this "stuck in some jerk's story" nonsense,
      either.
    ScreenActions:
    - rid: 8164893126226346117
    - rid: 8164893126226346118
    - rid: 8164893126226346119
    - rid: 8164893126226346120
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'd rather not believe that all my struggles up until now were just some
      heartstring-pulling backstory.
    ScreenActions:
    - rid: 8164893126226346121
    - rid: 8164893126226346122
    - rid: 8164893126226346123
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It's kinda funny, I remember fantasizing about getting isekai'd and away
      from my crappy, abusive dad.
    ScreenActions:
    - rid: 8164893126226346124
    - rid: 8164893126226346125
    - rid: 8164893126226346126
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: And here we are! In another world, but not in the way any of us wanted...
    ScreenActions:
    - rid: 8164893126226346143
    - rid: 8164893126226346144
    - rid: 8164893126226346145
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ... After the initial shock of being forced to go adventuring and stuff,
      just to not die wore off-
    ScreenActions:
    - rid: 8164893126226346127
    - rid: 8164893126226346146
    - rid: 8164893126226346147
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I had somewhat come to terms with being here for a while, where no one
      could put me down without a fight.
    ScreenActions:
    - rid: 8164893126226346128
    - rid: 8164893126226346131
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Figuratively, I mean.
    ScreenActions:
    - rid: 8164893126226346129
    - rid: 8164893126226346132
    - rid: 8164893126226346133
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'd always go down swinging if it ever came to that, even back home.
    ScreenActions:
    - rid: 8164893126226346140
    - rid: 8164893126226346141
    - rid: 8164893126226346142
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But that's not the point.
    ScreenActions:
    - rid: 8164893126226346136
    - rid: 8164893126226346138
    - rid: 8164893126226346139
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: '{mc}, after you left, Monika basically gave us a plan to get out of
      here.'
    ScreenActions:
    - rid: 8164893126226346137
    - rid: 8164893126226346148
    - rid: 8164893126226346149
    - rid: 8164893126226346150
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That right? Is this plan any good?
    ScreenActions:
    - rid: 8164893126226346151
    - rid: 8164893126226346152
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'Heck no! It basically amounted to:'
    ScreenActions:
    - rid: 8164893126226346153
    - rid: 8164893126226346154
    - rid: 8164893126226346155
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: '"Just do what you''ve been doing but keep an eye out for crazy people
      who know things and stuff."'
    ScreenActions:
    - rid: 8164893126226346156
    - rid: 8164893126226346157
    - rid: 8164893126226346158
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Pfft-
    ScreenActions:
    - rid: 8164893126226346160
    - rid: 8164893126226346161
    - rid: 8164893126226346159
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I know right? The hell am I supposed to do with that?
    ScreenActions:
    - rid: 8164893126226346162
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'But while she was telling us about her plan, she said some interesting
      stuff that I''ve been kinda holding onto:'
    ScreenActions:
    - rid: 8164893126226346163
    - rid: 8164893126226346164
    - rid: 8164893126226346165
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Even if that entity guy is trying to push our lives down a certain path-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: They're not all-knowing.
    ScreenActions:
    - rid: 8164893126226346167
    - rid: 8164893126226346169
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Surely they'd mind-wipe us by now, no? More convenient for their little
      story that way.
    ScreenActions:
    - rid: 8164893126226346168
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: So, if we want to fight back against that entity, we can.
    ScreenActions:
    - rid: 8164893126226346170
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: And I don't know about you-
    ScreenActions:
    - rid: 8164893126226346171
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But I'd prefer to give a jerk like that a piece of my mind!
    ScreenActions:
    - rid: 8164893126226346172
    - rid: 8164893126226346173
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It doesn't matter how many things it throws our way for whatever story
      arcs it wants-
    ScreenActions:
    - rid: 8164893126226346174
    - rid: 8164893126226346175
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm gonna keep bulldozing through them all until I can get my hands on
      that prick.
    ScreenActions:
    - rid: 8164893126226346176
    - rid: 8164893126226346177
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: So, c'mon {mc}, get out of your funk and help us bring that entity guy
      down a peg.
    ScreenActions:
    - rid: 8164893126226346178
    - rid: 8164893126226346179
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 8164893126226346180
    - rid: 8164893126226346183
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... huh.
    ScreenActions:
    - rid: 8164893126226346181
    - rid: 8164893126226346182
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 8164893126226346184
    - rid: 8164893126226346185
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Do we know the expected path of this courier?
    ScreenActions:
    - rid: 8164893126226346186
    - rid: 8164893126226346187
    - rid: 8164893126226346188
    - rid: 8164893126226346190
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: It'd probably be impossible to track them down otherwise.
    ScreenActions:
    - rid: 8164893126226346189
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm glad you asked.
    ScreenActions:
    - rid: 8164893126226346191
    - rid: 8164893126226346192
    - rid: 8164893126226346193
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: The courier was apparently traveling from Morrowind through Skyrim-
    ScreenActions:
    - rid: 8164893126226346195
    - rid: 8164893126226346196
    - rid: 8164893126226346197
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: So Vilkas says it's safe to assume that they entered the province at
      the border crossing in Riften.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Was the destination somewhere here in Skyrim?
    ScreenActions:
    - rid: 8164893126226346198
    - rid: 8164893126226346199
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It was going to change hands to another courier in Markarth before heading
      through to High Rock.
    ScreenActions:
    - rid: 8164893126226346200
    - rid: 8164893126226346201
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Vilkas and Aela thought, based on recent Forsworn motions in the area,
      that the courier was taken out in the Reach.
    ScreenActions:
    - rid: 8164893126226346202
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Get out your map, {mc}.
    ScreenActions:
    - rid: 8164893126226346203
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hm? Oh, sure.
    ScreenActions:
    - rid: 8164893126226346204
    - rid: 8164893126226346205
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Natsuki points along a road that leads through Falkreath into the Reach
      toward Markarth.
    ScreenActions:
    - rid: 8164893126226346206
    - rid: 8164893126226346207
    - rid: 8164893126226346208
    - rid: 8164893126226346209
    - rid: 8164893126226346210
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: The courier could've gotten ambushed pretty much anywhere along here.
    ScreenActions:
    - rid: 8164893149684301885
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'Assuming that the package they were carrying really <i>is</i> that valuable,
      the Forsworn probably took it here:'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Natsuki points at a rocky section of the map, near a waterfall.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Lost Valley Redoubt, the closest Forsworn stronghold.
    ScreenActions:
    - rid: 8164893149684301900
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So the plan is to head down to the Lost Valley Redoubt...
    ScreenActions:
    - rid: 8164893149684301886
    - rid: 8164893149684301887
    - rid: 8164893149684301888
    - rid: 8164893149684301896
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hopefully find what's left of the courier on the way there...
    ScreenActions:
    - rid: 8164893149684301889
    - rid: 8164893149684301897
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: And go clear out a whole dungeon to go get the package back.
    ScreenActions:
    - rid: 8164893149684301890
    - rid: 8164893149684301898
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Pretty much, yeah.
    ScreenActions:
    - rid: 8164893149684301891
    - rid: 8164893149684301892
    - rid: 8164893149684301899
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Haaahh... Fine, <i>quest-giver</i>.
    ScreenActions:
    - rid: 8164893149684301893
    - rid: 8164893149684301894
    - rid: 8164893149684301895
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: C'mon Sayori, let's just go.
    ScreenActions:
    - rid: 8164893149684301901
    - rid: 8164893149684301904
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What about Meeko?
    ScreenActions:
    - rid: 8164893149684301902
    - rid: 8164893149684301903
    - rid: 8164893149684301905
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You think you could get someone to take care of him while we're gone,
      Natsuki?
    ScreenActions:
    - rid: 8164893149684301906
    - rid: 8164893149684301907
    - rid: 8164893149684301908
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, sure.
    ScreenActions:
    - rid: 8164893149684301909
    - rid: 8164893149684301910
    - rid: 8164893149684301911
    - rid: 8164893149684301922
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: <NoiseText=3,1>Lucia</NoiseText>! Get your butt over here!
    ScreenActions:
    - rid: 8164893149684301912
    - rid: 8164893149684301913
    - rid: 8164893149684301914
    - rid: 8164893149684301923
  - speaker: {fileID: 11400000, guid: 6dd6201afbe165745bd64197b76cdf48, type: 2}
    dialog: Yes, Miss Not-suki?
    ScreenActions:
    - rid: 8164893149684301917
    - rid: 8164893149684301915
    - rid: 8164893149684301918
    - rid: 8164893149684301919
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: You're gonna be taking care of this dog while these two are out whoopin'
      butt.
    ScreenActions:
    - rid: 8164893149684301927
    - rid: 8164893149684301928
    - rid: 8164893149684301929
  - speaker: {fileID: 11400000, guid: 6dd6201afbe165745bd64197b76cdf48, type: 2}
    dialog: A d-doggy?!?
    ScreenActions:
    - rid: 8164893149684301930
    - rid: 8164893149684301931
    - rid: 8164893149684301932
    - rid: 8164893149684301933
  - speaker: {fileID: 11400000, guid: 6dd6201afbe165745bd64197b76cdf48, type: 2}
    dialog: Yeah! I love dogs!
    ScreenActions:
    - rid: 8164893149684301934
    - rid: 8164893149684301935
    - rid: 8164893149684301936
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'Well, now that that''s dealt with, one last thing for you, {mc}, here:'
    ScreenActions:
    - rid: 8164893149684301937
    - rid: 8164893149684301938
    - rid: 8164893149684301940
    - rid: 8164893149684302197
    - rid: 8164893149684302198
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Natsuki hands {mc} a small, organized stack of papers.
    ScreenActions:
    - rid: 8164893149684302199
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What's this?
    ScreenActions:
    - rid: 8164893149684302200
    - rid: 8164893149684302201
    - rid: 8164893149684302202
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Didya already forget that you told us to note down any word walls we
      came across?
    ScreenActions:
    - rid: 8164893149684302203
    - rid: 8164893149684302204
    - rid: 8164893149684302205
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Sure, I forgot to give it to you all those times we met up before...
    ScreenActions:
    - rid: 8164893166592851968
    - rid: 8164893166592851969
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But <i>you</i> were the one who asked!
    ScreenActions:
    - rid: 8164893166592851970
    - rid: 8164893166592851971
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Huh.
    ScreenActions:
    - rid: 8164893166592852034
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Thanks, Natsuki. If there's nothing else, let's go, Sayori.
    ScreenActions:
    - rid: 8164893166592851972
    - rid: 8164893166592851973
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Okay~!
    ScreenActions:
    - rid: 8164893166592851974
    - rid: 8164893166592851975
    - rid: 8164893166592851976
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893166592851977
    - rid: 8164893166592851978
    - rid: 8164893166592851979
    - rid: 8164893166592851980
    - rid: 8164893166592852035
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, where're we going again?
    ScreenActions:
    - rid: 8164893166592852036
    - rid: 8164893166592852037
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I wasn't really paying attention to the map when Natsuki was pointing
      it out...
    ScreenActions:
    - rid: 8164893166592852038
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Lost Valley Redoubt, mostly west of here and kinda south in a mountainous
      area called the Reach.
    ScreenActions:
    - rid: 8164893166592852039
    - rid: 8164893166592852040
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Okay, thanks {mc}!
    ScreenActions:
    - rid: 8164893166592852041
    - rid: 8164893166592852042
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The two of them leave town and start heading to the Redoubt.
    ScreenActions:
    - rid: 8164893166592852043
    - rid: 8164893166592852044
  playerChoices:
  - choiceText: 
    resultingSequence: {fileID: 11400000, guid: 694b7fc933b8a874aac861f67b81a129, type: 2}
    conditions: []
