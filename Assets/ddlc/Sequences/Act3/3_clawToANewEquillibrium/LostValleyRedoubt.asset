%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: LostValleyRedoubt
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 8164893304793595998
    - rid: 8164893304793595999
    - rid: 8164893304793596009
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Okay Sayori, the Redoubt should be just across this river.
    ScreenActions:
    - rid: 8164893304793596007
    - rid: 8164893304793596008
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You sure, {mc}?
    ScreenActions:
    - rid: 8164893304793596010
    - rid: 8164893304793596011
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... yeah.
    ScreenActions:
    - rid: 8164893304793596012
    - rid: 8164893304793596013
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'Look:'
    ScreenActions:
    - rid: 8164893304793596014
    - rid: 8164893304793596015
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: As you can tell by the changes of elevation here on the map, and those
      big pillars up there-
    ScreenActions:
    - rid: 8164893304793596016
    - rid: 8164893304793596017
    - rid: 8164893304793596018
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: As well as the river in the way-
    ScreenActions:
    - rid: 8164893304793596019
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: We're at the Redoubt.
    ScreenActions:
    - rid: 8164893304793596020
    - rid: 8164893304793596021
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Okay~!
    ScreenActions:
    - rid: 8164893304793596022
    - rid: 8164893304793596023
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: How're we gonna get across the river, though?
    ScreenActions:
    - rid: 8164893304793596024
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: There's nothing stopping us from just jumping across those rocks-
    ScreenActions:
    - rid: 8164893304793596025
    - rid: 8164893304793596026
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, that sounds like fun!
    ScreenActions:
    - rid: 8164893304793596027
    - rid: 8164893304793596028
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Last one there's a rotten egg-!
    ScreenActions:
    - rid: 8164893304793596029
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: As Sayori runs her way toward the rocks, {mc} has a sudden flashback
      to an implanted memory where Sayori tripped and fell at a park, scraping her
      knee.
    ScreenActions:
    - rid: 8164893304793596031
    - rid: 8164893304793596032
