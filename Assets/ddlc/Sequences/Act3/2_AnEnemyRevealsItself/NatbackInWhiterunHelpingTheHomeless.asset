      type: {class: Conditional_Screen_Overrider, ns: RenCSharp.Sequences, asm: Sequences}
      data:
        possibleScreens:
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 0
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
            dialog: Of course you're right!
            ScreenActions:
            - rid: 4972360592123756613
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 1
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
            dialog: ... I think there was a better option.
            ScreenActions: []
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 2
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
