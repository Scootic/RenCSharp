      type: {class: Actor_Expression, ns: RenCSharp.Sequences, asm: Sequences}
      data:
        actorToAlter: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
        visualSpriteIndexes:
        - 
        - 
        - lookAwaySad
        - 
    - rid: 4972360592123756619
      type: {class: Conditional_Screen_Overrider, ns: RenCSharp.Sequences, asm: Sequences}
      data:
        possibleScreens:
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 0
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
            dialog: But! She'd have the dignity of working for her keep!
            ScreenActions:
            - rid: 4972360592123756622
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 1
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
            dialog: (Ah... When you put it like that...)
            ScreenActions:
            - rid: 4972360592123756621
        - conditions:
          - flagToCheck: garbage
            operation: 0
            desiredValue: 2
            persistent: 0
            debugResult: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
            dialog: (Nah, it's fine. It's not easy to admit when you don't know something,
              so I get it.)
            ScreenActions:
            - rid: 4972360592123756620
