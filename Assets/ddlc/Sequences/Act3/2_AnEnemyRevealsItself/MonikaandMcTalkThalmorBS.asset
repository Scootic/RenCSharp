    - rid: 4972360225885257977
    - rid: 4972360225885257978
    - rid: 4972360225885257979
    - rid: 4972360225885257980
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: This isn't really a bathroom break, is it? So what's up?
    ScreenActions:
    - rid: 4972360225885257981
    - rid: 4972360225885257982
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
