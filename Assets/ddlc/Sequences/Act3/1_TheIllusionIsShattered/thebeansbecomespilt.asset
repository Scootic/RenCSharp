          resultingScreen:
            speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
            dialog: Is the player the person who possessed us, {mc}?
            ScreenActions:
            - rid: 1790118673552506971
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 1
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
            dialog: I was possessed by <b>them</b> in the barrow, that's why I fought
              the giant spider despite being terrified.
            ScreenActions:
