      type: {class: Conditional_Screen_Overrider, ns: RenCSharp.Sequences, asm: Sequences}
      data:
        possibleScreens:
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 15
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 7f7b29852cc3f074bb27f1cb70589b4e, type: 2}
            dialog: I think so...
            ScreenActions:
            - rid: 1790118673552506978
            - rid: 1790118673552506979
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 13
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
            dialog: Uh, I think I did when I was fighting some bears; I slammed some
              gem onto my hammer which made it all fiery.
            ScreenActions:
            - rid: 1790118673552506981
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 11
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
            dialog: Um, I believe I was possessed back in Saarthal; when we were
              trapped, I was able to spew out flames despite not knowing how to do
              that.
            ScreenActions:
            - rid: 1790118673552506982
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 9
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
            dialog: No? Lucky for you, then.
            ScreenActions: []
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 1
            persistent: 0
            bitWise: 1
          resultingScreen:
            speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
            dialog: Uh, well...
            ScreenActions:
            - rid: 1790118673552506983
        - conditions:
          - flagToCheck: WeirdRoute
            operation: 0
            desiredValue: 0
            persistent: 0
            bitWise: 0
          resultingScreen:
            speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
            dialog: I'm cute, please call me that, even if Natsuki would never say
              that.
            ScreenActions:
            - rid: 1790118673552506977
