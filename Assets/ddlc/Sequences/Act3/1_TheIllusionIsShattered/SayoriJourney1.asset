  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Phew...)
    ScreenActions:
    - rid: 4972360123630747662
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (My feet haven't recovered since when I left Winterhold! They're so sore!)
