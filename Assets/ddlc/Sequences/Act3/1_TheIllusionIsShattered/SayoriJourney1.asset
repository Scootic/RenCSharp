  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Eh? What's going on here?)
    ScreenActions:
    - rid: 4972360123630747674
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: We've got a walker! Drop the stones!
    ScreenActions:
    - rid: 4972360136931147776
    - rid: 4972360136931147777
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Eek-!
    ScreenActions:
    - rid: 4972360136931147908
    - rid: 4972360136931147909
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4972360136931147778
    - rid: 4972360136931147779
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (I gotta get outta here!)
    ScreenActions:
    - rid: 4972360136931147780
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori, seeing no other path of escape, tries to run through the now
      rock-laden path while being harassed by arrows.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4972360136931147910
    - rid: 4972360136931147911
  - speaker: {fileID: 0}
