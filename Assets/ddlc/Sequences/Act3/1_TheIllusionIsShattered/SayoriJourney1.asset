    ScreenActions:
    - rid: 4972360050559942658
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Ah, uh...)
    ScreenActions:
    - rid: 4972360050559942661
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (I have a question for <b>you</b>.)
    ScreenActions:
    - rid: 4972360050559942662
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Um-)
    ScreenActions:
    - rid: 4972360050559942663
