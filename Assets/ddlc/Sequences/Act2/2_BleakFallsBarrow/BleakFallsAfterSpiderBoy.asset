%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: BleakFallsAfterSpiderBoy
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: Huh? What just-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I look upon the now dead spider.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Look at you! Taking on your fears like a man! Good job, {mc}.
    ScreenActions:
    - rid: 9079474864314122468
    - rid: 9079474864314122469
    - rid: 9079474864314122470
    - rid: 9079474864314122471
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: B-b-but I... wha-...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I don't-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Hey, so much of that was him, and how much of that was <b>you</b>?)
    ScreenActions:
    - rid: 9079474864314122472
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474864314122473
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I could sort of tell, {mc} had a weird look in his eye when he was fighting
      the spider...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (And I'm pretty sure Sayori noticed too.)
    ScreenActions:
    - rid: 9079474864314122474
  - speaker: {fileID: 0}
    dialog: Sayori walks closer to me and begins whispering to me.
    ScreenActions:
    - rid: 9079475089592287488
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ({mc}, are you okay?)
    ScreenActions:
    - rid: 9079475089592287489
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (H-huh?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (You were making a face I've never seen before...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (And I've seen you scared before, that wasn't your scared face.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I-I-I...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Sayori... can you keep a secret?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (... of course, {mc}...)
    ScreenActions:
    - rid: 9079474864314122475
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I really REALLY didn't want to fight that spider.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Well, yeah, you're scared of spiders after all-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (And I was trying to do everything in my power to <i>not</i> fight it,
      I wanted to just stay where I was...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Huh? Then why did you?)
    ScreenActions:
    - rid: 9079474864314122479
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (There was a... voice. In my head.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (... yeah?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (It wasn't <i>my</i> voice. It was a voice I've never heard in my whole
      life.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Huh? What did the voice sound like?)
    ScreenActions:
    - rid: 9079474864314122480
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (That's... one of the weird parts.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (The voice didn't have a... sound. But it somehow still spoke to me.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (What did it say?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (It said that... that...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (That I needed to fight the spider, and that I was letting you all down.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Oh, {mc}...)
    ScreenActions:
    - rid: 9079474864314122481
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (And I didn't fight the spider because of the guilt-tripping-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I tried to tell it no, but-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (<Speed=1>But I didn't have a choice.</Speed>)
    ScreenActions:
    - rid: 9079475089592287490
    - rid: 9079474864314122483
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (... did something like this happen in the game, too?)
    ScreenActions:
    - rid: 9079474864314122484
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (No. Never.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (...)
    ScreenActions:
    - rid: 9079474864314122485
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Is there something we can do to help...?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (<i>I don't know</i>...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (I'm sorry, {mc}.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Please tell me if something like this happens again...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Yeah, of course, Sayori.)
    ScreenActions:
    - rid: 9079474864314122486
  - speaker: {fileID: 0}
    dialog: Natsuki barges in.
    ScreenActions:
    - rid: 9079474864314122488
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Watcha two love birds whispering about!
    ScreenActions:
    - rid: 9079475089592287491
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Natsuki!
    ScreenActions:
    - rid: 9079474864314122489
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I just... wasn't feeling too hot.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: We're waiting on you, {mc}. What's next?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh, right.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Well, what's next is Arvel.
    ScreenActions: []
