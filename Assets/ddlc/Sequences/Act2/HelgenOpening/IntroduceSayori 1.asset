%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: IntroduceSayori 1
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475098267418889
    - rid: 9079475089592287594
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>...
    ScreenActions:
    - rid: 9079474749396484196
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Wake up!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Erggrumbba...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Wake up!
    ScreenActions:
    - rid: 9079474749396484197
    - rid: 9079474749396484198
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Narr...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: There are people who need healing, apprentice, now WAKE UP!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uwaaah! I'm up, I'm up!
    ScreenActions:
    - rid: 9079474749396484199
    - rid: 9079474749396484200
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: H-huh?
    ScreenActions:
    - rid: 9079474749396484201
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Are you deaf? Just go get the blue mountain flowers.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh... who are you?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: And where am I?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Kynareth guide me...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: I am your master, and you are in the Temple of Kynareth in Whiterun Hold.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Satisfied?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh... how far away is that from Sakura, Japanifornia?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: What?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: I've never heard of a place called Sakura, or... how did you say it,
      Jappanehfornya?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Japanifornia. That's where I'm from, and-
    ScreenActions:
    - rid: 9079474749396484205
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah shoot! The festival's today!
    ScreenActions:
    - rid: 9079474749396484206
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I gotta call Monika and let her know I'll be late!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Sayori reaches into her pocket to get her phone.
    ScreenActions:
    - rid: 9079474749396484207
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Only to then realize that her armor doesn't have pockets.
      Also, that she's wearing armor instead of her pajamas.
    ScreenActions:
    - rid: 9079474749396484208
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah crap...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: ... I didn't know there was going to be a festival...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: Or that the captain of the guard would have something to do with it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Eh? What's a captain of the guard got to do with anything?
    ScreenActions:
    - rid: 9079474749396484209
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: 'You said Monika, right? '
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: I only know of one Monika in Skyrim, and she's the captain of the guard
      here in Whiterun.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: So, Monika's here?
    ScreenActions:
    - rid: 9079474749396484210
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: I mean, I've heard talk of her going with some guards to clear out bandits,
      but-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Thank you, whatever your name is!
    ScreenActions:
    - rid: 9079474749396484211
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Sayori rushes out of the temple, looking for Monika.
    ScreenActions:
    - rid: 9079474749396484212
    - rid: 9079474749396484213
  - speaker: {fileID: 11400000, guid: 129f3e6ecb9761b428cce10986af598f, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474749396484215
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484219
    - rid: 9079475098267418890
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Now if I were Monika, where would I be...?
    ScreenActions:
    - rid: 9079474749396484218
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Wait... where even am I, anyway?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Before having the chance to actually think about her perdicament,
      Sayori spots someone that looks like Monika in armor.
    ScreenActions:
    - rid: 9079474749396484220
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Heeeeey~! Monika!
    ScreenActions:
    - rid: 9079474749396484222
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Before giving "Monika" a chance to react, Sayori runs directly
      toward her, and gets her in one of her hugs.
    ScreenActions:
    - rid: 9079474749396484223
    - rid: 9079474749396484224
    - rid: 9079474749396484225
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Oh, hi Sayori. I guess you're here too.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yes I am!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh, that's right!
    ScreenActions:
    - rid: 9079474749396484226
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Do you know where we are, Monika?
    ScreenActions:
    - rid: 9079474749396484227
    - rid: 9079474749396484228
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474749396484233
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Very far from home; I know that much.
    ScreenActions:
    - rid: 9079474749396484234
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh no...
    ScreenActions:
    - rid: 9079474749396484235
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What if Natsuki and Yuri get too nervous without us, and {mc} can't help
      them when they're performing?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... what?
    ScreenActions:
    - rid: 9079474749396484236
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You know, at the festival?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: They were both pretty nervous performing for us, so-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... Sayori, that's what you're worried about?
    ScreenActions:
    - rid: 9079474749396484237
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Of course! They're our friends, and we can't help them, so-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... Sayori, did you seriously forget the part where we are far from home,
      and don't know where we are, <i>and</i> don't have phones to call for help?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474749396484238
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ... uh oh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What are we going to do, Monika?!?
    ScreenActions:
    - rid: 9079474749396484239
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Well, first, we're going to go link up with {mc}.
    ScreenActions:
    - rid: 9079474749396484240
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: He's around here too? How do you know that?
    ScreenActions:
    - rid: 9079474749396484241
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uhh...
    ScreenActions:
    - rid: 9079474749396484242
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: A little birdie told me...
    ScreenActions:
    - rid: 9079474749396484243
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Look, that part's not important.
    ScreenActions:
    - rid: 9079474749396484244
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What <i>is</i> important, is sticking together.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: The guards and I are going to take care of some bandits-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Or whatever...
    ScreenActions:
    - rid: 9079474749396484245
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: That alone implies that this place is dangerous enough, or poor enough,
      to have banditry be a serious problem.
    ScreenActions:
    - rid: 9079474749396484246
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, Monika...?
    ScreenActions:
    - rid: 9079474749396484247
    - rid: 9079475089592287595
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yeah?
    ScreenActions:
    - rid: 9079474749396484248
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What's a bandit?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474749396484249
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: They're like thieves, who lie in wait to ambush travelers to plunder
      their valuables.
    ScreenActions:
    - rid: 9079474749396484250
    - rid: 9079475089592287596
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh! Thanks, Monika!
    ScreenActions:
    - rid: 9079474749396484251
    - rid: 9079474749396484252
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: You're welcome, Sayori.
    ScreenActions:
    - rid: 9079474749396484253
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Anyway, the point is, we have good reason to believe that this place
      is dangerous, and we should stick together.
    ScreenActions:
    - rid: 9079474749396484254
    - rid: 9079474749396484255
    - rid: 9079475089592287597
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Of course, Madame President!
    ScreenActions:
    - rid: 9079474749396484256
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You're always supposed to stick with a buddy when you're on a trip to
      somewhere you haven't been before!
    ScreenActions:
    - rid: 9079474749396484257
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, yeah. Whatever floats your boat, Sayori.
    ScreenActions:
    - rid: 9079474749396484258
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey wait, if we're going to deal with bandits, are we going to meet up
      with {mc} along the way?
    ScreenActions:
    - rid: 9079474749396484259
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Well, {mc}'s already on his way heading our direction, so we'll probably
      meet up with him halfway if we go deal with the bandits.
    ScreenActions:
    - rid: 9079474749396484260
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... right?)
    ScreenActions:
    - rid: 9079474749396484261
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484262
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Oh come on, you were the one that said he was heading this way, how
      do you not know?)
    ScreenActions:
    - rid: 9079474749396484263
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: '1: There are lots of places those bandits could be.'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: '2: Last I saw of {mc}, he was leaving a town called Riverwood...'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: And I'm sure you already know time flows differently in there than out
      here, so he could already be at the city gates, or only just left Riverwood.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... crap.)
    ScreenActions:
    - rid: 9079474749396484264
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, Monika? Are you talking to yourself?
    ScreenActions:
    - rid: 9079474749396484265
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uhh...
    ScreenActions:
    - rid: 9079474749396484266
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Y-yeah! I was just trying to organize my thoughts, that's all. Ahaha!
    ScreenActions:
    - rid: 9079474749396484267
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh, okay!
    ScreenActions:
    - rid: 9079474749396484268
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: ... uh, captain?
    ScreenActions:
    - rid: 9079474749396484269
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... you were here the whole time, weren't you?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, that's right!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What's your name, mister?
    ScreenActions:
    - rid: 9079474749396484270
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: O-oh. It's Ivar, miss.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ivar... that's a nice name.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: ... no one's ever said that to me before...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Let's just go...
    ScreenActions:
    - rid: 9079474749396484271
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Aye aye, captain!
    ScreenActions:
    - rid: 9079474749396484272
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Monika, Sayori, and Ivar all go to where the rest of the
      guards are gathered.
    ScreenActions:
    - rid: 9079474749396484273
    - rid: 9079474749396484274
