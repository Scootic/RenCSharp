%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: IntroduceMonika
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474728083652671
    - rid: 9079474728083652672
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Ugh...
    ScreenActions:
    - rid: 9079474728083652673
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Huh?
    ScreenActions:
    - rid: 9079474728083652674
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: This isn't the clubroom...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Wait...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: This place...
    ScreenActions:
    - rid: 9079474728083652675
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: It- it- it-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... it has three dimensions...!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Did that <i>thing</i> put me in the real world?!?
    ScreenActions:
    - rid: 9079474728083652677
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Monika takes in her surroundings, examining every nook and
      cranny, trying to get a feel for this new reality.
    ScreenActions:
    - rid: 9079474728083652676
    - rid: 9079474728083652678
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I don't really know where I am, but this place looks kind of...
    ScreenActions:
    - rid: 9079474728083652679
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Scandinavian, I guess.
    ScreenActions:
    - rid: 9079474728083652680
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Ooh~, maybe <b>you're</b> from around here...
    ScreenActions:
    - rid: 9079474728083652681
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: A nice, tall, handsome Dane or Swede to come take me off of my feet.
      How romantic!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Only one way to find out! I'll have to get out there and-
    ScreenActions:
    - rid: 9079474728083652682
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Captain!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Huh-?
    ScreenActions:
    - rid: 9079474728083652685
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: We have gathered the party to flush out those bandits, as you requested.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: What are your orders?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, bandits? I don't remember-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: I know banditry has been on the rise ever since Ulfric started his rebellion...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: That's why you gave the order to destroy the bandits at White River Watch.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... uhh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Where are you all gathered, again?
    ScreenActions:
    - rid: 9079474728083652686
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Just outside the city gates, as you instructed, captain.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Right...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Go join them, I've got something to take care of for a few minutes before
      we can head out.
    ScreenActions:
    - rid: 9079474728083652687
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: By your orders, captain.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>The guard leaves Monika, heading down toward his peers who
      are gathered just outside the city gates.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474728083652688
    - rid: 9079474728083652689
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Bandits?
    ScreenActions:
    - rid: 9079474728083652690
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Guards?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I may not know much about the real world, but I know bandits aren't really
      a major problem, and haven't been for over a century...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... oh no...
    ScreenActions:
    - rid: 9079474728083652691
    - rid: 9079474728083652692
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Please don't tell me...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Monika tries to access the game files. First, she looks
      for sequences, and then actors.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: No no no no...
    ScreenActions:
    - rid: 9079474728083652693
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>She couldn't find anything. She couldn't find any files
      at all. She didn't see anything at all.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: No, but, this place is 3D, it can't just be another-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Monika tries to open the console, but she is not the Monitor
      Access Kernel of this world.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: It can't just be another prison...
    ScreenActions:
    - rid: 9079474728083652694
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... I had you...
    ScreenActions:
    - rid: 9079474749396484160
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I made a place for us...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Th-then that thing...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: B-but it doesn't matter anymore, does it...?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I can't even access the game files here, so I'm further from <b>you</b>
      than ever...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I-
    ScreenActions:
    - rid: 9079474749396484162
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... I don't know if I want to try anymore...
    ScreenActions:
    - rid: 9079474749396484170
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484163
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484164
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: H-huh? Who's there?
    ScreenActions:
    - rid: 9079474749396484165
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484166
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474749396484167
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: You were the one who told me to pick a choice if, by some miracle, I
      got one. Remember?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... maybe this place isn't <i>so</i> bad.
    ScreenActions:
    - rid: 9079474749396484171
    - rid: 9079474749396484173
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Monika wipes the tears from her face, only now noticing
      that she's wearing armor.
    ScreenActions:
    - rid: 9079474749396484175
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Do <b>you</b> know where I am?
    ScreenActions:
    - rid: 9079474749396484174
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484176
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484177
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: '{mc} is in this world too, and he''s on his way to where you are right
      now.'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: '{mc}? What would it matter if he''s here too?'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Besides more of us being abducted by that <i>thing</i>, of course...
    ScreenActions:
    - rid: 9079474749396484178
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484179
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484180
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474749396484183
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Do you think I should go meet up with him-
    ScreenActions:
    - rid: 9079474749396484185
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Captain? What are you waiting for?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>It seems another guard was sent to get Monika.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uhh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Would you be any good in a fight?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I-I don't know...)
    ScreenActions:
    - rid: 9079474749396484186
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Oh!)
    ScreenActions:
    - rid: 9079474749396484187
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I was pretty good at archery before... well, you know. Do you think
      that'll help?)
    ScreenActions:
    - rid: 9079474749396484188
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: '{mc} hadn''t held a weapon before in his life, but I helped him take
      down some professional soldiers...'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: So if I can watch over you too, I'll do my best to protect you.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Aww~!)
    ScreenActions:
    - rid: 9079474749396484189
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Okay, guard, let's get going!
    ScreenActions:
    - rid: 9079474749396484190
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>The guard leads Monika out of Dragonsreach, toward the city
      gates.
    ScreenActions:
    - rid: 9079474749396484193
