  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: IntroduceNatsuki 1
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475089592287591
    - rid: 9079475098267418886
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Guhh...
    ScreenActions:
    - rid: 9079474749396484277
    - rid: 9079475089592287592
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: Boss, wake up!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Muhh, five more minuhs...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: We don't have the time, you idiot!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...!
    ScreenActions:
    - rid: 9079474749396484279
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Who are you calling idiot-
    ScreenActions:
    - rid: 9079474749396484280
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: There's no time for this- the scout just reported back that the Whiterun
      guard is en route for us!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Natsuki looks around, suddenly noticing that she's not in
      her home, or anywhere that she knows.
    ScreenActions:
    - rid: 9079474749396484281
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Where the hell am I? And why does it smell like piss?!?
    ScreenActions:
    - rid: 9079474749396484283
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: Dammit, the boss's gone mad...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: Look, just come up to the watch point.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>The bandit starts going further through the cave, which
      eventually leads upward.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Since she's confused, and disoriented from just being woken
      up, Natsuki decides to follow the bandit in hopes of learning more.
    ScreenActions:
    - rid: 9079474749396484284
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475098267418887
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: You see those yellow-lookin' blobs out there?
    ScreenActions:
    - rid: 9079474749396484286
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Natsuki squints her eyes to get a better look. Sure enough,
      there are some yellow blobs that seem to be approaching.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: What about 'em?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: That's the guard, you mudcrab, and they're comin' to kill us!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: K-kill us?!?
    ScreenActions:
    - rid: 9079474749396484287
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: That's right, and I know for a fact none of the fresh recruits have ever
      made it through a raid before...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 4ad5dd808ad82574db508b579bfc59b8, type: 2}
    dialog: How are we going to whip them into shape, boss?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ... I-I... uhh...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474771628392448
    - rid: 9079475098267418888
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: We're here. Your orders, captain?
    ScreenActions:
    - rid: 9079474771628392450
    - rid: 9079474771628392451
    - rid: 9079475089592287593
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Hmm...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (The bandits have the high ground, so...)
    ScreenActions:
    - rid: 9079474771628392504
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: 'First, we need to secure the entrance of the cave. '
    ScreenActions:
    - rid: 9079474771628392505
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: So, should we charge in?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uhh...
    ScreenActions:
    - rid: 9079474771628392506
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (What do you think?)
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474771628392507
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Alright.)
    ScreenActions:
    - rid: 9079474771628392508
    - rid: 9079474771628392519
    - rid: 9079474771628392544
