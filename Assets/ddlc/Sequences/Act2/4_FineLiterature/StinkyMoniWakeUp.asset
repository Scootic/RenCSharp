%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: StinkyMoniWakeUp
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Get your lazy butt up, {mc}!
    ScreenActions:
    - rid: 4351268099428974767
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: It's been about an hour since I had breakfast.
    ScreenActions:
    - rid: 4351268099428974768
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So, get up! We've probably got a big day ahead of us.
    ScreenActions:
    - rid: 4351268099428974770
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Guhh... what time is it?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Based on the light from the windows? I'd guess around 10 in the morning.
    ScreenActions:
    - rid: 4351268099428974771
  - speaker: {fileID: 0}
    dialog: ... fudge.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, get out of here so I can get dressed.
    ScreenActions:
    - rid: 4351268099428974772
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What? You don't want me to look?
    ScreenActions:
    - rid: 4351268099428974773
  - speaker: {fileID: 0}
    dialog: ... I'm not in the mood for this nonsense...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I give Monika the meanest glare I can.
    ScreenActions:
    - rid: 4351268099428974774
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Fine, fine, I'll leave.
    ScreenActions:
    - rid: 4351268099428974775
  - speaker: {fileID: 0}
    dialog: Jeez...
    ScreenActions:
    - rid: 4351268099428974776
    - rid: 4351268099428974777
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268099428974778
  - speaker: {fileID: 0}
    dialog: After getting dressed, I had a small breakfast since we'd probably be
      having lunch soon.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So...? What are we doing today?
    ScreenActions:
    - rid: 4351268099428974780
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, we'll be heading north, since that's where Alftand is.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: We'll also have to go through some frosty water to get a brass box from
      a maniac.
    ScreenActions:
    - rid: 4351268099428974781
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, what? Why?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Because we'll need it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... we should also probably get better equipment, but I'm not entirely
      sure where to start with that, since we've been working on a budget...
    ScreenActions:
    - rid: 4351268099428974782
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Player.AddItem 000000f 999999!
    ScreenActions:
    - rid: 4351268099428974784
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... huh?
    ScreenActions:
    - rid: 4351268099428974783
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: It was worth a shot...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What? Were you trying to do something?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That was the console command to spawn in a bunch of septims.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Wait, so the actual game has a console too?
    ScreenActions:
    - rid: 4351268099428974785
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, it's a pretty buggy game, so it's really nice that they left it
      in-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'Wait, what do you mean by: "too?"'
    ScreenActions:
    - rid: 4351268099428974786
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, don't worry about it. Let's just get moving.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Whatever.
    ScreenActions: []
