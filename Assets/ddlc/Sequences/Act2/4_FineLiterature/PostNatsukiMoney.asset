%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: PostNatsukiMoney
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Anyway, Skjor wants to talk to you again.
    ScreenActions:
    - rid: 4351268349337141267
    - rid: 4351268349337141268
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Skjor? What is it this time?
    ScreenActions:
    - rid: 4351268349337141269
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I dunno, Skjor doesn't really tell me much.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Wait...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Didn't {mc} say that Skjor's going to try and make me a werewolf?!?)
    ScreenActions:
    - rid: 4351268349337141270
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (...)
    ScreenActions:
    - rid: 4351268349337141271
    - rid: 4351268349337141272
    - rid: 4351268349337141273
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ({mc} said I should talk to Vilkas or Kodlak...)
    ScreenActions:
    - rid: 4351268349337141274
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268349337141275
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Harbinger, do you have a minute?
    ScreenActions:
    - rid: 4351268349337141276
    - rid: 4351268349337141277
    - rid: 4351268349337141278
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Of course, Shield-Sister; one of the benefits of old age.
    ScreenActions:
    - rid: 4351268349337141279
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: What do you need?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It's about Skjor.
    ScreenActions:
    - rid: 4351268349337141280
    - rid: 4351268349337141281
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Skjor, hm? I know he's the not the most friendly man, but I'm not sure
      if he'd ever do something worth reporting about-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm pretty sure he's going to try and make me a werewolf.
    ScreenActions:
    - rid: 4351268349337141282
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: ... is that right?
    ScreenActions:
    - rid: 4351268349337141283
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: And how do you know this?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (... crap. I don't have any proof, especially since I haven't talked
      to him yet...)
    ScreenActions:
    - rid: 4351268349337141284
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (I guess I could lie, and just tell Kodlak about what Skjor would say
      to me if I went to talk to him.)
    ScreenActions:
    - rid: 4351268349337141285
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: After I finished my job with Farkas, he told me that Skjor was looking
      for me-
    ScreenActions:
    - rid: 4351268349337141286
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: When I spoke to him, he told me to meet him at the Underforge at midnight.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I asked him about what we would be doing there, but he just dodged the
      question.
    ScreenActions:
    - rid: 4351268349337141287
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: The Underforge <i>is</i> where we undergo the ritual to receive the beast
      blood...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Although, I'm not sure why <i>you</i> would think of that connection.
    ScreenActions:
    - rid: 4351268349337141288
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: But, it seems to be as you say.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I knew Skjor was trying to go behind my back, but not to this extent...
    ScreenActions:
    - rid: 4351268349337141289
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Thank you for bringing this to my attention.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: You should still go to this meeting, that way we can catch Skjor in the
      act.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Don't worry, I'll enter the Underforge shortly after you do.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Don't speak of this meeting to anyone, we don't want Skjor to catch wind
      of our plans; do you understand, Shield-Sister?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yes.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Good.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Anything else?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: That's all I wanted to talk about, Harbinger.
    ScreenActions:
    - rid: 4351268349337141290
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Very well. See you tonight.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: See you.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268349337141291
    - rid: 4351268349337141292
    - rid: 4351268349337141293
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Alright, now to actually go talk to Skjor...)
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
