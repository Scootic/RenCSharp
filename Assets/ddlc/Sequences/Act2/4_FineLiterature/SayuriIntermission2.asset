  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: SayuriIntermission2
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268349337141394
    - rid: 4351268349337141395
    - rid: 4351268349337141396
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: -divine intervention?!? That doesn't help at all!
    ScreenActions:
    - rid: 4351268349337141398
    - rid: 4351268349337141399
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Because you don't believe in those gods?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: No, <i>because</i> that would require access to a shrine to the Divines,
      which we do not.
    ScreenActions:
    - rid: 4351268349337141400
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh... ehehe~
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well, let's try the third volume, maybe it'll actually be helpful!
    ScreenActions:
    - rid: 4351268349337141401
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: I hope you're right...
    ScreenActions:
    - rid: 4351268349337141402
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri opens up the third volume of "Teleportation Praixs".
    ScreenActions:
    - rid: 4351268349337141403
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri reads aloud so Sayori can hear too.
    ScreenActions:
    - rid: 4351268349337141404
    - rid: 4972360475574796431
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well now, there's something!
    ScreenActions:
    - rid: 4351268349337141407
    - rid: 4351268349337141409
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: The "spiritual anchor" method...
    ScreenActions:
    - rid: 4351268349337141410
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Sounds magical!
    ScreenActions:
    - rid: 4351268349337141411
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: There's just one problem, Sayori.
    ScreenActions:
    - rid: 4351268349337141412
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What's that?
    ScreenActions:
    - rid: 4351268349337141413
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: The book didn't say anything about <i>how</i> to make <i>or</i> use those
      spiritual anchors.
    ScreenActions:
    - rid: 4351268349337141417
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Oh.
    ScreenActions:
    - rid: 4351268349337141416
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well, I'm hungry! Let's eat before we read any more books on teleportation.
    ScreenActions:
    - rid: 4351268349337141418
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Okay...
    ScreenActions:
    - rid: 4351268349337141419
    - rid: 4351268349337141420
