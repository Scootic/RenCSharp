%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: StinkyMoniRainYori
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What's Sayori doing leaning up against that sign post?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, what?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I look over toward the sign post and-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sayori?!?
    ScreenActions:
    - rid: 4351268147175358572
    - rid: 4351268147175358573
  - speaker: {fileID: 0}
    dialog: I quickly dash over to her-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Ow! Hey-!
    ScreenActions:
    - rid: 4972360475574796419
  - speaker: {fileID: 0}
    dialog: Dropping Monika in the process.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Which, for right now, I'm okay with, considering I have something far
      more important to do.
    ScreenActions:
    - rid: 4351268147175358577
  - speaker: {fileID: 0}
    dialog: 'Alright, first overview on her condition:'
    ScreenActions:
    - rid: 4351268147175358578
  - speaker: {fileID: 0}
    dialog: Skin's paler than usual, and cold to the touch.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: She's still breathing, faintly but at a steady pace.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: No signs of blood loss, or other major injuries.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I grab onto her shoulders and begin shaking her violently.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: <NoiseText=3,1>WAKE UP</NoiseText>!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ahh!!!
    ScreenActions:
    - rid: 4351268147175358584
    - rid: 4351268147175358585
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oof!
    ScreenActions:
    - rid: 4972360475574796420
  - speaker: {fileID: 0}
    dialog: Sayori shoves me back, causing me to lose my footing and fall over.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: That's my purse! I don't know you-!
    ScreenActions:
    - rid: 4351268147175358587
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Ahaha!
    ScreenActions:
    - rid: 4351268147175358588
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}?'
    ScreenActions:
    - rid: 4351268147175358654
    - rid: 4351268147175358655
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}!'
    ScreenActions:
    - rid: 4351268147175358656
  - speaker: {fileID: 0}
    dialog: Just as I pick myself up off the ground, Sayori pulls me into a hug.
    ScreenActions:
    - rid: 4351268147175358657
    - rid: 4351268147175358658
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hey... hey... it's alright.
    ScreenActions:
    - rid: 4351268147175358659
  - speaker: {fileID: 0}
    dialog: Of course, I begin hugging her back. Gotta warm her up somehow!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What were you doing out here all by yourself?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri... she...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yuri? What did she do?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: It was the middle of the night, I got up to pee and-
    ScreenActions:
    - rid: 4351268147175358660
    - rid: 4351268147175358663
  - speaker: {fileID: 0}
    dialog: TMI, Sayori.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: And Yuri was cutting herself!
    ScreenActions:
    - rid: 4351268147175358661
    - rid: 4351268147175358662
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... She... <NoiseText=3,1>WHAT</NoiseText>?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: And then she ran away! And no one knew where she went! And-!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: <NoiseText=3,1>Waaaaaaah</NoiseText>!
    ScreenActions:
    - rid: 4351268147175358664
  - speaker: {fileID: 0}
    dialog: Oh that's BAD bad...!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Guess that cat's out of the bag, now.)
    ScreenActions:
    - rid: 4351268147175358665
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, crap... did you ask any of the guards if they saw her?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351268147175358666
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: No...
    ScreenActions:
    - rid: 4351268147175358667
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Then that's where we'll start.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: If any of the guards saw her on patrol last night, they should be back
      in town by now.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I let go of Sayori, and take a few steps back.
    ScreenActions:
    - rid: 4351268147175358668
    - rid: 4351268147175358669
    - rid: 4351268147175358670
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: C'mon you two, we don't have time to waste.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
