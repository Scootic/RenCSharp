  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: SayuriIntermission3
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268399126675473
    - rid: 4351268399126675474
    - rid: 4351268399126675475
    - rid: 4351268399126675479
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: So, where <i>are</i> the two of you from?
    ScreenActions:
    - rid: 4351268399126675476
    - rid: 4351268399126675477
    - rid: 4351268399126675478
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: I've never seen Nords or any other of the races of men with your hair
      color...
    ScreenActions:
    - rid: 4351268399126675480
    - rid: 4351268399126675481
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Uh, should we tell her?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Would she even believe us?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: And you're definitely not Mer... your ears are rounded.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: Are you perhaps from Akavir, or even Pyandonea?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Where?!?)
    ScreenActions:
    - rid: 4351268399126675483
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Other continents here on Nirn, maybe?)
    ScreenActions:
    - rid: 4351268399126675482
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Uh, no... we're not from either of those places...
    ScreenActions:
    - rid: 4351268399126675484
    - rid: 4351268399126675485
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: If not there, then where?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: We're from Japanifornia!
    ScreenActions:
    - rid: 4351268399126675486
    - rid: 4351268399126675487
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: ... where?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Sayori, we don't know what'll happen if we tell them the truth!)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Eh, I'm sure it'll be fine. I told my master back in Whiterun about
      when I first woke up and nothing bad happened.)
    ScreenActions:
    - rid: 4351268399126675488
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
