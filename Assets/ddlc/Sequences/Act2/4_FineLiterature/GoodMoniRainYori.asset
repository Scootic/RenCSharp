%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: GoodMoniRainYori
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...!
    ScreenActions:
    - rid: 4351268147175358571
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, what's up Monika? You were in the middle of a sentence-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... it's Sayori...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Huh? Sayori?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I look over toward the sign post, and sure enough-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sayori!!!
    ScreenActions:
    - rid: 4351268147175358575
  - speaker: {fileID: 0}
    dialog: I begin running toward her, dropping my arms to let Monika down.
    ScreenActions:
    - rid: 4351268147175358581
  - speaker: {fileID: 0}
    dialog: Once I've reached her, I begin an initial overview of her condition.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Her skin is paler than usual and cold to the touch.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: She's breathing steadily, even if it's faint.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: There's no sign of blood loss or any other type of major injury.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I grab onto her shoulders and begin shaking her.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: C'mon, <i>wake up, Sayori<i>- it's me...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Grnk, huh-?
    ScreenActions:
    - rid: 4351268147175358601
    - rid: 4351268147175358604
    - rid: 4351268147175358607
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}...?'
    ScreenActions:
    - rid: 4351268147175358602
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}!'
    ScreenActions:
    - rid: 4351268147175358603
    - rid: 4351268147175358605
  - speaker: {fileID: 0}
    dialog: Sayori wraps her arms around me.
    ScreenActions:
    - rid: 4351268147175358606
  - speaker: {fileID: 0}
    dialog: Of course, I return her hug. Gotta warm her up somehow!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Monika walks up to us and makes our hug a group one.
    ScreenActions:
    - rid: 4351268147175358608
    - rid: 4351268147175358609
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hey, Sayori... what were you doing out here?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I w-was on my w-way to see you guys...
    ScreenActions:
    - rid: 4351268147175358622
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hey... if you really missed us, you could've just written a letter-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: <NoiseText=3,1>No no no</NoiseText>!
    ScreenActions:
    - rid: 4351268147175358623
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri was <NoiseText=3,1>cutting herself</NoiseText>, {mc}!
    ScreenActions:
    - rid: 4351268147175358637
  - speaker: {fileID: 0}
    dialog: ... WHAT?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: AND YOU LEFT HER <NoiseText=3,1>ALONE</NoiseText>?!?
    ScreenActions:
    - rid: 4351268147175358638
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: <NoiseText=3,1>NO</NoiseText>! How could you say that?!?
    ScreenActions:
    - rid: 4351268147175358639
    - rid: 4351268147175358640
    - rid: 4351268147175358641
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, where is she?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I don't <NoiseText=3,1>knooooow</NoiseText>!
    ScreenActions:
    - rid: 4351268147175358642
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: That's why I went looking for you guys...
    ScreenActions:
    - rid: 4351268147175358645
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Did you ask around if anyone saw her?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: The only person who saw her, saw her leave our dorms...
    ScreenActions:
    - rid: 4351268147175358646
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Everyone else I asked says they didn't see her last night...
    ScreenActions:
    - rid: 4351268147175358647
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Did you ask any of the guards?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: No...
    ScreenActions:
    - rid: 4351268147175358649
  - speaker: {fileID: 0}
    dialog: I let go of Sayori and take a step back.
    ScreenActions:
    - rid: 4351268147175358650
    - rid: 4351268147175358651
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: And when did she go missing?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: The middle of last night- I don't know exactly when...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Then the guards who were on patrol last night are probably back, and
      have reported their findings.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: C'mon you two, we don't have time to waste.
    ScreenActions:
    - rid: 4351268147175358652
    - rid: 4351268147175358653
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
