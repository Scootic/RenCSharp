%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: ReturntoWhiterun
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568055
    - rid: 268099980525568056
    - rid: 268099980525568058
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So... how exactly are we going to make it to-
    ScreenActions:
    - rid: 268099980525568060
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What'd you call it again? Skull-something?
    ScreenActions:
    - rid: 268099980525568059
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Skuldafn, Monika.
    ScreenActions:
    - rid: 268099980525568061
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Since it's up surrounded by mountains, I'm gonna be riding a dragon to
      get there.
    ScreenActions:
    - rid: 268099980525568062
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Also, you're not going-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Wait, no hold on, you're going to be riding a dragon?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: How?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Ah, don't worry about it. You'll see.
    ScreenActions:
    - rid: 268099980525568063
  - speaker: {fileID: 0}
    dialog: Just as we start taking the steps up to the Winds District, the second
      layer of Whiterun...
    ScreenActions:
    - rid: 268099980525568064
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Isn't it about dinner time?
    ScreenActions:
    - rid: 268099980525568065
  - speaker: {fileID: 0}
    dialog: Monika points up toward the sun, showing how it is beginning to set for
      the evening.
    ScreenActions:
    - rid: 268099980525568066
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, you're right.
    ScreenActions:
    - rid: 268099980525568067
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Guess I'll go save the world tomorrow; let's get some rest.
    ScreenActions:
    - rid: 268099980525568068
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Won't your new sword also be done by tomorrow, {mc}?
    ScreenActions:
    - rid: 268099980525568069
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hey, you're right!
    ScreenActions:
    - rid: 268099980525568070
  - speaker: {fileID: 0}
    dialog: The two of us head into the Bannered Mare to wind down our day.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568071
    - rid: 268099980525568072
  - speaker: {fileID: 0}
    dialog: The two of us have a brief dinner, not really talking about much of consequence.
    ScreenActions:
    - rid: 268099980525568073
  - speaker: {fileID: 0}
    dialog: Afterwards, we pay the 20 septim fare to get rooms for the night.
    ScreenActions:
    - rid: 268099980525568074
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Ah... an actual bed...
    ScreenActions:
    - rid: 268099980525568075
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: See you tomorrow, good night, Monika.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Good night, {mc}.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Monika leaves toward her own room for the night.
    ScreenActions:
    - rid: 268099980525568076
  - speaker: {fileID: 0}
    dialog: And I... I close my eyes, ready to get some much needed rest...
    ScreenActions:
    - rid: 268099980525568077
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568078
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Psst. Hey!)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Do you think {mc}'s plan is actually going to work?)
    ScreenActions:
    - rid: 268099980525568079
    - rid: 268099980525568081
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (You know, the whole "kill Alduin, go home" thing?)
    ScreenActions:
    - rid: 268099980525568082
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568083
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568084
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Well, no matter what happens...)
    ScreenActions:
    - rid: 268099980525568088
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568087
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Good night.)
    ScreenActions:
    - rid: 268099980525568089
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
