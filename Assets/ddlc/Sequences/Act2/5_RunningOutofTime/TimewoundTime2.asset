%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: TimewoundTime2
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099795830178009
    - rid: 268099795830178010
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: This is the top?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: <i>Technically</i> no, but we <i>can</i> see the peak, it's right up
      there-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I point up toward the tip of the throat of the world.
    ScreenActions:
    - rid: 268099819477139457
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Neat!
    ScreenActions:
    - rid: 268099819477139456
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So, where's Paarthurnax-
    ScreenActions:
    - rid: 268099819477139458
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Eek!
    ScreenActions:
    - rid: 268099819477139526
    - rid: 268099819477139527
    - rid: 268099819477139529
    - rid: 268099819477139530
    - rid: 268099819477139531
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: He's right there.
    ScreenActions:
    - rid: 268099819477139532
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Drem yol lok. It's been long since I've had a visitor on my mountain,
      let alone two.
    ScreenActions:
    - rid: 268099819477139533
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: <i>Your</i> mountain? Who decided that?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Because, politically, this mountain would be owned by the Jarl of Whiterun,
      since it lies within his hold.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: More than that, though, this mountain would be Kynareth's, no?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Vahzah, I suppose you are right.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: It would be more accurate to say that this is my home.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Fair enough, you've been up here for, what, four thousand years?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Hm. Give or take.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: But you never answered my question, why are you here?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I got an Elder Scroll to read.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: A Kel? And why would you need to read it here, in this obscure place?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Because of the time-wound that was made when Alduin was banished.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I thought you already knew about that?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: I- yes, of course. I was just surprised by your gonal. Your initiative.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Few would be able to source an Elder Scroll, fewer still would know how
      to read them safely.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, sure.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, if you'll excuse me, I've got some reading to do.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: If I may ask, what do you hope to find?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Dragonrend, as spoken by the ancient Nords.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Of course... you seek to defeat Alduin, then?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What? No! There's some random dragon plaguing my village-
    ScreenActions:
    - rid: 268099819477139534
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah. I'm trying to defeat Alduin.
    ScreenActions:
    - rid: 268099819477139535
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: But why? Why must you defeat Alduin?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, on the one hand I'd prefer the world to not be dominated by dragons
      again.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: On the other, Alduin not doing his job is the whole reason I have dragonblood
      in my veins, so I might as well.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: You're very... sulak, nonchalant, about a destiny given to you by the
      gods.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I mean, I've been doing nothing but working towards defeating Alduin
      since I got here, so I'd say I've actually been pretty serious.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Since you got here?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Ah, don't worry about it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Hm.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: So you are just a plaything to destiny, then? Your whims are decided
      by the wheel of fate?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The wheel of fate?
    ScreenActions:
    - rid: 268099819477139537
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Don't get me started on the wheel of fate!
    ScreenActions:
    - rid: 268099819477139536
    - rid: 268099819477139538
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Why does it spin in a circle, eating itself?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: How can it shatter into multiple wheels, but reform back into one with
      all the characteristics of its children?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: And why does it look like a tower if you look at it funny?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Do you even <i>know</i> about the Towers, Mr. Partysnax?
    ScreenActions:
    - rid: 268099819477139540
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Well, of course I know about the Towers, I've been present for all of
      linear time.
    ScreenActions:
    - rid: 268099819477139539
    - rid: 268099819477139541
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: You are remarkebly knowledgeable in the underlying realities most mortals
      live without ever glimpsing...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, I get that.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: By what manner of...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: Oh! Now that I get a better look at you, I can see it now.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 0d41391b7f2d50840b7fc352caf0c9b6, type: 2}
    dialog: My apologies for interrupting you, Prisoners-Who-Know.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Paarthurnax takes flight, landing at the peak of the mountain.
    ScreenActions:
    - rid: 268099819477139542
    - rid: 268099819477139543
    - rid: 268099819477139544
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Isn't that what Septimus called us? Prisoners-Who-Know?
    ScreenActions:
    - rid: 268099819477139545
    - rid: 268099819477139546
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Huh. You're right.
    ScreenActions:
    - rid: 268099819477139547
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I guess that lends credence to his theories, if a minor Aedric being
      like Paarthurnax stands by it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, it's reading time!
    ScreenActions:
    - rid: 268099819477139548
  - speaker: {fileID: 0}
    dialog: I step into the time-wound and open up the Elder Scroll...
    ScreenActions:
    - rid: 268099819477139549
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099819477139550
    - rid: 268099819477139551
    - rid: 268099819477139552
  - speaker: {fileID: 0}
    dialog: Huh.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: There's a notable scent of ash permeating the air.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Probably a consequence of the actively in-progress war with the dragons.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: There's what's-his-face.
    ScreenActions:
    - rid: 268099819477139553
    - rid: 268099819477139554
  - speaker: {fileID: 11400000, guid: 2a64402107978094a96cebc7935371ad, type: 2}
    dialog: Daar sul thur se Alduin vokrii-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: And there's the dragon.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Mr. Battleaxe starts fighting the dragon.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Pretty sure Gormlaith should be here any second now...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 530167e172e34fd4bbbcf5df0eb05db4, type: 2}
    dialog: Know that Gormlaith sent you down to death!
    ScreenActions:
    - rid: 268099819477139555
    - rid: 268099819477139556
  - speaker: {fileID: 0}
    dialog: Is it weird that I remember her name, but not the other two?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: The two of them successfully slay the dragon.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 530167e172e34fd4bbbcf5df0eb05db4, type: 2}
    dialog: Hakon! A glorious day, is it not?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Oh, that's his name.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: be7d4bf59e4126046aadb631d33a56c5, type: 2}
    dialog: The battle below goes ill. If Alduin does not rise to our challenge,
      I fear all may be lost.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: What a bunch of shmucks!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I feel like it's poor military strategy to bank on killing the enemy
      leader.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: It's a lot more practical to properly defeat your enemies in totality,
      even if you can't kill every single enemy combatant.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Although, I'm not sure how sabotaging dragon supply lines would work...
      they're probably fairly self-sufficient.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Oh, there's the other guy.
    ScreenActions:
    - rid: 268099819477139557
  - speaker: {fileID: 0}
    dialog: He's actually voiced by the same guy as Colonel Campbell from Metal Gear.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: You do not understand. Alduin cannot be slain like a lesser dragon.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Not with that attitude!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: The robed guy pulls out the Elder Scroll.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: That's some quality Elder Scroll-ception; he's got the same one I have!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 530167e172e34fd4bbbcf5df0eb05db4, type: 2}
    dialog: We shall see soon enough. Alduin approaches!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Ah, good. The important part!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: The winged-lizard of the hour lands atop the word wall.
    ScreenActions:
    - rid: 268099819477139558
    - rid: 268099819477139560
    - rid: 268099819477139561
    - rid: 268099819477139562
    - rid: 268099819477139563
    - rid: 268099819477139564
  - speaker: {fileID: 0}
    dialog: Wait, who put that word wall up here anyway?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: c9971f7409084c140a7ff61c782e0c80, type: 2}
    dialog: Meyye! Tahrodiis aanne! Him hinde pah liiv! Zu'u hin daan!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 530167e172e34fd4bbbcf5df0eb05db4, type: 2}
    dialog: Let those that watch from Sovngarde envy us this day!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: be7d4bf59e4126046aadb631d33a56c5, type: 2}
    dialog: <font=dragonfont>j8r z4 frul</font>!
    ScreenActions:
    - rid: 268099819477139565
  - speaker: {fileID: 0}
    dialog: Joor... Zah... Frul...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Noted!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I guess I gotta wait around for them to get desperate...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Took 'em long enough, jeez...
    ScreenActions:
    - rid: 268099819477139566
  - speaker: {fileID: 0}
    dialog: There goes Gormlaith!
    ScreenActions:
    - rid: 268099819477139567
    - rid: 268099819477139568
    - rid: 268099819477139569
    - rid: 268099819477139570
  - speaker: {fileID: 11400000, guid: be7d4bf59e4126046aadb631d33a56c5, type: 2}
    dialog: No, damn you!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: be7d4bf59e4126046aadb631d33a56c5, type: 2}
    dialog: It's no use. Use the Scroll, Felldir! Now!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Oh, that's <i>his</i> name!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I wasn't really paying attention...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: Hold, Alduin on the Wing!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: Sister Hawk, grant us your sacred breath to make this contract heard!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: Begone, World-Eater! By words with older bones than your own, we break
      your perch on this age and send you out!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: You are banished!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: Alduin, we shout you out from all our endings unto the last!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: c9971f7409084c140a7ff61c782e0c80, type: 2}
    dialog: Faal Kel...?!? Nikriinne...!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Bye bye, Alduin! I'll be seeing <i>you</i> in a minute...
    ScreenActions:
    - rid: 268099819477139572
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: You are banished!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: be7d4bf59e4126046aadb631d33a56c5, type: 2}
    dialog: It worked... you did it...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: b3a27c107ade02c48abd446b964760c6, type: 2}
    dialog: Yes, the World-Eater is gone... may the spirits have mercy on our souls.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I wonder if they could actually zero-sum Alduin, or something, if Felldir
      worded his "contract" differently...
    ScreenActions:
    - rid: 268099819477139573
    - rid: 268099819477139574
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099819477139575
    - rid: 268099819477139576
  - speaker: {fileID: 0}
    dialog: Uh... what?
    ScreenActions:
    - rid: 268099819477139581
  - speaker: {fileID: 0}
    dialog: ... is this the loading screen?!?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: So we're <i>literally</i> in the game?!?
    ScreenActions:
    - rid: 268099842819752084
    - rid: 268099842819752085
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
