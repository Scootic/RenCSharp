  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: DeadSkjorReport
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240224
    - rid: 268099503569240225
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Uhh... what time is it?)
    ScreenActions:
    - rid: 268099503569240226
    - rid: 268099503569240227
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (I still feel pretty tired, so it must be around morning...)
    ScreenActions:
    - rid: 268099503569240228
    - rid: 268099640005492822
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (...)
    ScreenActions:
    - rid: 268099640005492824
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Guess I should actually go report Skjor's death back to Jorrvaskr now...)
    ScreenActions:
    - rid: 268099503569240229
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240230
    - rid: 268099503569240232
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Finally, I've just about made it back to Whiterun.)
    ScreenActions:
    - rid: 268099503569240233
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: As Natsuki approaches the city gate...
    ScreenActions:
    - rid: 268099503569240234
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: You there, halt!
    ScreenActions:
    - rid: 268099503569240235
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Excuse me? Do you need something?
    ScreenActions:
    - rid: 268099503569240236
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Yeah... those ears...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (My ears...?)
    ScreenActions:
    - rid: 268099503569240237
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Would you happen to know anything about the reports of a feral pink werewolf
      last night?
    ScreenActions:
    - rid: 268099503569240238
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Uh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: No...?
    ScreenActions:
    - rid: 268099503569240239
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 268099503569240240
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Very well, then.
    ScreenActions:
    - rid: 268099503569240241
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The Whiterun guard steps to the side, allowing Natsuki into the city.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240242
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (What'd that guard mean by my ears-?)
    ScreenActions:
    - rid: 268099503569240243
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Natsuki pushes her hair back to touch her ears-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Wait, what's that weird pokey bit on my head-)
    ScreenActions:
    - rid: 268099503569240244
    - rid: 268099503569240246
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Are those dog ears?!? Why do I have dog ears?!?)
    ScreenActions:
    - rid: 268099503569240245
    - rid: 268099503569240247
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (The other Companions don't have dog ears!!!)
    ScreenActions:
    - rid: 268099503569240248
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240249
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240250
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099503569240251
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Welcome back, Shield-Sister, I hear you've-
    ScreenActions:
    - rid: 268099503569240252
    - rid: 268099503569240253
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Why do I have dog ears?!?
    ScreenActions:
    - rid: 268099503569240254
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: ... why <i>do</i> you have dog ears?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Why don't you know?!? You're a werewolf too, aren't you?!?
    ScreenActions:
    - rid: 268099503569240255
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Whoa, lower your voice, that's not something you should-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Lower my voice? I'm too busy <i>freaking the hell out</i>!
    ScreenActions:
    - rid: 268099503569240256
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: What're the others going to say when they see me like this?!?
    ScreenActions:
    - rid: 268099503569240257
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Who?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Not your problem, that's who!
    ScreenActions:
    - rid: 268099503569240258
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I'll admit, this isn't something I've ever seen before-
    ScreenActions:
    - rid: 268099503569240259
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: But as far as problems are concerned, this seems only cosmetic.
    ScreenActions:
    - rid: 268099503569240260
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Considering you are still lucid enough to worry about appearances.
    ScreenActions:
    - rid: 268099503569240261
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Only cosmetic my foot...!
    ScreenActions:
    - rid: 268099503569240262
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I doubt there's anything stopping you from just getting them removed,
      if you're really worried about it.
    ScreenActions:
    - rid: 268099503569240263
    - rid: 268099503569240264
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ... get them removed?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Yes, there's no shortage of blades around here-
    ScreenActions:
    - rid: 268099503569240265
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I think I'd rather consult a professional if I wanted these removed...
    ScreenActions:
    - rid: 268099503569240267
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Very well.
    ScreenActions:
    - rid: 268099503569240266
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (... what was I doing here, again?)
    ScreenActions:
    - rid: 268099503569240268
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Oh, right.)
    ScreenActions:
    - rid: 268099503569240269
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: By the way, Skjor died at Gallow's Rock; the fort me and Aela were raiding.
    ScreenActions:
    - rid: 268099503569240270
    - rid: 268099503569240272
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: ... Skjor's dead?
    ScreenActions:
    - rid: 268099503569240271
    - rid: 268099503569240273
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, he went in ahead of us and was overwhelmed.
    ScreenActions:
    - rid: 268099503569240274
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: And what about Aela, is she okay?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Oh yeah, she's fine. She said something about tracking down the Silver
      Hand for revenge.
    ScreenActions:
    - rid: 268099503569240275
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: It's good that she's still alive, but her judgement is probably clouded.
    ScreenActions:
    - rid: 268099503569240277
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: How so?
    ScreenActions:
    - rid: 268099503569240276
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I'm sure you've seen by now how she's heavily influenced by the beast
      blood.
    ScreenActions:
    - rid: 268099523943333888
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Her bloodlust is only really kept in check by the steady supply it gets
      from our line of work.
    ScreenActions:
    - rid: 268099523943333889
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: So, her form of mourning is likely to result in...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Death.
    ScreenActions:
    - rid: 268099523943333890
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: And while I can sympathize; our hearts mourn with hers for the loss of
      one of our own-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: She's probably going to take more "payment" than is due, which will only
      make things worse.
    ScreenActions:
    - rid: 268099523943333891
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: She did say that she was going to make the Silver Hand "tremble at our
      sight..."
    ScreenActions:
    - rid: 268099523943333892
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I see...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: We'll have to talk to Kodlak about this, before this gets out of hand.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099523943333894
    - rid: 268099523943333895
    - rid: 268099523943333896
    - rid: 268099523943333897
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Vilkas. Is something bothering you-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Oh, it's you, Shield-Sister.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I'm sorry for not coming in soon enough, maybe you could've avoided the
      transformation if I arrived sooner...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Hm.
    ScreenActions:
    - rid: 268099523943333898
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Don't worry about it. It's Skjor's and Aela's fault, anyway.
    ScreenActions:
    - rid: 268099523943333900
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Speaking of-
    ScreenActions:
    - rid: 268099523943333899
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Natsuki and Vilkas bring Kodlak up to speed regarding Skjor's death and
      Aela's machinations.
    ScreenActions:
    - rid: 268099523943333901
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I see...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: She's probably going to track down their leaders in hopes of assassinating
      them.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I doubt she'll do the killing alone; that's how Skjor died, after all.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: So it's safe to assume that she'll return here before she can get herself
      killed?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Do we have reason to believe otherwise, Shield-Sister?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I wouldn't know, she only told me to come back here to report about Skjor's
      death.
    ScreenActions:
    - rid: 268099523943333902
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I see.
    ScreenActions:
    - rid: 268099523943333903
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: It's for the best that we stay around until she comes back, then.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Thank you for bringing this matter to my attention, you two.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Of course, Harbinger.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'll be working at the Skyforge with Eorlund, then.
    ScreenActions:
    - rid: 268099523943333905
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: See you later.
    ScreenActions:
    - rid: 268099523943333906
    - rid: 268099523943333907
    - rid: 268099523943333908
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: ... why did she have noticeable wolf ears?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I'm not sure, you were there for her first transformation, weren't you?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: I was, yes.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: And here I thought that the strangeness of her beast blood would be limited
      to her being a <i>pink</i> werewolf...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099523943333909
    - rid: 268099523943333910
    - rid: 268099523943333911
    - rid: 268099523943333912
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Hey, Eorlund.
    ScreenActions:
    - rid: 268099523943333913
    - rid: 268099523943333914
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Good day, Shield-Sister.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Have you come to work the forge with me again?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yep. What's on the docket for today?
    ScreenActions:
    - rid: 268099523943333915
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Some broken farm tools, a large order of nails, repairing some damaged
      chainmail...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
