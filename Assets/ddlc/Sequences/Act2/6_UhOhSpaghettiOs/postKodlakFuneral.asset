  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Who will start?
    ScreenActions:
    - rid: 1790118469574328344
    - rid: 1790118469574328345
    - rid: 1790118469574328346
    - rid: 1790118469574328347
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: I'll do it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: Before the ancient flame...
    ScreenActions:
    - rid: 1790118469574328348
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: We grieve.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: At this loss...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: We weep.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: For the fallen...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: We shout.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: And for ourselves...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: (We take our leave.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: We take our leave.
    ScreenActions:
    - rid: 1790118469574328349
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The Companions who gathered for Kodlak's funeral take one final brief
      moment of respect before returning to their daily lives.
