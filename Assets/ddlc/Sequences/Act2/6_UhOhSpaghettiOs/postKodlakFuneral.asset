%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: postKodlakFuneral
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118469574328341
    - rid: 1790118469574328342
    - rid: 1790118469574328343
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Who will start?
    ScreenActions:
    - rid: 1790118469574328344
    - rid: 1790118469574328345
    - rid: 1790118469574328346
    - rid: 1790118469574328347
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: I'll do it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: Before the ancient flame...
    ScreenActions:
    - rid: 1790118469574328348
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: We grieve.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: At this loss...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: We weep.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: For the fallen...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: We shout.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: And for ourselves...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: (We take our leave.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: We take our leave.
    ScreenActions:
    - rid: 1790118469574328349
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The Companions who gathered for Kodlak's funeral take one final brief
      moment of respect before returning to their daily lives.
    ScreenActions:
    - rid: 1790118469574328351
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Let us go to the Underforge.
    ScreenActions:
    - rid: 1790118469574328411
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: You too, Shield-Sister.
    ScreenActions:
    - rid: 1790118469574328415
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118469574328412
    - rid: 1790118469574328413
    - rid: 1790118469574328414
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: We're heading out to Ysgramor's Tomb once Eorlund finishes reforging
      the axe, yeah?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: That's the plan; he did say that he had to finish sharpening it the last
      time I checked in with him.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: Surely he would've shown it off at the funeral in honor of Kodlak if
      it <i>was</i> ready-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: His service deserved to be about him, not our accomplishments.
    ScreenActions:
    - rid: 1790118469574328416
    - rid: 1790118469574328417
    - rid: 1790118469574328418
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Eorlund walks into the Underforge, bearing Ysgramor's Axe.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Woah...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: That's it, the axe?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: Of course.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: So? Who shall have the honor of wielding such a storied blade?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Fine, I'll do it, since none of you guys have the guts.
    ScreenActions:
    - rid: 1790118469574328419
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: I'm not as well trained with two-handed weapons...
    ScreenActions:
    - rid: 1790118469574328420
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: I prefer using my bow and arrow...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Eh, I got nothing.
    ScreenActions:
    - rid: 1790118469574328421
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I probably would've grabbed it if you didn't.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Before we head out, where is Ysgramor's Tomb again?
    ScreenActions:
    - rid: 1790118469574328422
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: A small island, just west of Winterhold.
    ScreenActions:
    - rid: 1790118469574328423
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: <i>Greaaat</i> more cold for me...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 257fa6872c2d2f24f900979e35fb64cc, type: 2}
    dialog: If it really bothers you that much, I could look into getting you some
      new armor-
    ScreenActions:
    - rid: 1790118469574328424
  - speaker: {fileID: 11400000, guid: 6f47b2f061a0a3249992cdd21d6995ed, type: 2}
    dialog: We don't have time for that now, Kodlak's soul needs delivering to Sovngarde.
    ScreenActions:
    - rid: 1790118469574328425
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Haaahh... I really don't like you right now.)
    ScreenActions:
    - rid: 1790118469574328426
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: Let's make haste then, to Ysgramor's Tomb!
    ScreenActions:
    - rid: 1790118469574328427
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
