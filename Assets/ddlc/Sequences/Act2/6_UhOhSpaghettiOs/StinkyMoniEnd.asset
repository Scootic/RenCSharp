%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: StinkyMoniEnd
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (So... are the other girls actually where I'm expecting them to be-?)
    ScreenActions:
    - rid: 1790118603885641728
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Natsuki in Whiterun, and the other two in Winterhold?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Actually, right now all three of them should be in Winterhold.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (That right?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Today Yuri spent her time studying at the College, while Sayori stayed
      in bed because she's sick.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Ah. That's too bad.)
    ScreenActions:
    - rid: 1790118603885641729
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (What about Natsuki, why is she in Winterhold?)
    ScreenActions:
    - rid: 1790118603885641730
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: She was on Companions business; curing her and the previous leader's
      lycanthropy.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: She decided to spend the night at the inn in Winterhold before heading
      back to Whiterun.
    ScreenActions:
    - rid: 1790118603885641731
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Also, she might be the leader of the Companions now.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (After, like, three days?)
    ScreenActions:
    - rid: 1790118603885641732
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I'm not sure whether to be impressed with her, or disappointed with
      them, ahaha!)
    ScreenActions:
    - rid: 1790118603885641733
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I guess I'll be heading north tomorrow, then.)
    ScreenActions:
    - rid: 1790118603885641734
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Hopefully I can catch Natsuki somewhere around the city itself, that
      way we don't have to walk as much.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ('Cause, you know, my steed has a case of depression.)
    ScreenActions:
    - rid: 1790118603885641735
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Now that I think about, wasn't Sayori supposed to have depression?)
    ScreenActions:
    - rid: 1790118603885641736
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I remember checking in on the sequence after I left {mc}'s house, when
      Sayori revealed that she was bipolar in <i>our</i>...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Version? Continuity? Alternate universe? Timeline?)
    ScreenActions:
    - rid: 1790118603885641737
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Whatever the word you prefer, her being bipolar doesn't really come
      up that much...)
    ScreenActions:
    - rid: 1790118603885641738
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Maybe it was toned down too?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Not that I'd be able to check that, even if we were home...!)
    ScreenActions:
    - rid: 1790118603885641739
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (In any case, I'll be seeing you tomorrow.)
    ScreenActions:
    - rid: 1790118603885641740
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I've got to get my rest for my long march, after all!)
    ScreenActions:
    - rid: 1790118603885641741
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Good night, good lookin'.)
    ScreenActions:
    - rid: 1790118603885641742
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: True to her word, Monika gets prepared for bed and gets under the covers
      for the night.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
