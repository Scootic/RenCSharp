  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Never, huh?)
    ScreenActions:
    - rid: 4927988362429071449
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Well, I'll join the resounding chorus that says you should give it a
      go.)
    ScreenActions:
    - rid: 4927988362429071450
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Ahaha, chorus...)
    ScreenActions:
    - rid: 4927988362429071451
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Anyway, the science is pretty clear on the benefits:)
    ScreenActions:
    - rid: 4927988362429071452
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Playing an instrument helps with your memory, motor skills, and even
      school subjects like reading or math.)
    ScreenActions:
    - rid: 4927988362429071453
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (But, more than that, I think it's good for the soul!)
    ScreenActions:
    - rid: 4927988362429071454
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Which, uh-)
    ScreenActions:
    - rid: 4927988385720565760
    - rid: 4927988385720565761
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Might be the only thing I have.)
    ScreenActions:
    - rid: 4927988385720565762
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (But that's okay!)
    ScreenActions:
    - rid: 4927988385720565763
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (It's not like I'm alone.)
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4927988385720565764
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions:
    - rid: 4927988385720565766
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (So yeah, pick up an instrument and make some music!)
    ScreenActions:
    - rid: 4927988385720565767
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... Now that I'm thinking about it, this place probably doesn't have
      pianos.)
    ScreenActions:
    - rid: 4927988385720565768
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (At the inns I've seen drums and lutes, but no keyboard instruments.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Guess I'll have a rough time finishing my song...)
    ScreenActions:
    - rid: 4927988385720565769
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Oh, maybe I can check out the Bard School, or whatever {mc} called it.)
    ScreenActions:
    - rid: 4927988385720565770
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
