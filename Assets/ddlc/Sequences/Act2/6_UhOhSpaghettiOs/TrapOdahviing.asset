  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: TrapOdahviing
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4927988090927316992
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The barracks should be right through here.
    ScreenActions:
    - rid: 4927988090927316993
    - rid: 4927988090927316994
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4927988090927316995
    - rid: 4927988090927316996
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Oh, hello captain. Anything to report to us?
    ScreenActions:
    - rid: 4927988090927316997
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yeah. Are there any other guards here who are currently off-duty?
    ScreenActions:
    - rid: 4927988090927316998
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Ilgand and Gertrude are currently patrolling the dungeon and everyone
      else is out on patrol, why?
    ScreenActions:
    - rid: 4927988090927316999
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Do we need two guards specifically, {mc}?)
    ScreenActions:
    - rid: 4927988090927317000
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (The mechanism definitely requires two people to operate, but I guess
      there isn't anything stopping you from being the other person.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Is it complicated or something?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Nah, I'm pretty sure it's just two chains you gotta pull at the same
      time.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: That's fine, but you need to come with us.
    ScreenActions:
    - rid: 4927988090927317001
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: What's the matter? Brigands? Bandits? Lost sweetroll?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Nope!
    ScreenActions:
    - rid: 4927988090927317002
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We're gonna catch a dragon.
    ScreenActions:
    - rid: 4927988090927317004
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: I...
    ScreenActions:
    - rid: 4927988090927317012
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Wha-
    ScreenActions:
    - rid: 4927988090927317005
    - rid: 4927988090927317013
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Why-?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: How?!?
    ScreenActions:
    - rid: 4927988090927317006
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: A dragon, to save the world, and with a trap up on the balcony of Dragonsreach.
    ScreenActions:
    - rid: 4927988090927317008
    - rid: 4927988090927317014
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: Oh.
    ScreenActions:
    - rid: 4927988090927317009
  - speaker: {fileID: 11400000, guid: 89f7d0b97106b6448939eb57dd9aa235, type: 2}
    dialog: We're luring a dragon into <i>our</i> city?!? That's a horrible idea-!
    ScreenActions:
    - rid: 4927988090927317010
    - rid: 4927988090927317015
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: It's not as bad of an idea as you think.
    ScreenActions:
    - rid: 4927988090927317011
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
