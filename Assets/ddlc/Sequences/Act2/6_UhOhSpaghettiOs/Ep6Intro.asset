  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: Ep6Intro
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099980525568090
    - rid: 268099980525568091
    - rid: 268099980525568092
    - rid: 268099980525568093
    - rid: 268099980525568094
  - speaker: {fileID: 0}
    dialog: Ah...
    ScreenActions:
    - rid: 268099980525568095
  - speaker: {fileID: 0}
    dialog: Something smells good...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I guess Hulda's making some breakfast, which I should definitely get
      in on.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099999270699008
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh. Hey, Monika.
    ScreenActions:
    - rid: 268099999270699009
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Is that stew as good as it smells?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yep!
    ScreenActions:
    - rid: 268099999270699010
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What's in it, anyway?
    ScreenActions:
    - rid: 268099999270699011
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: It's got tomatoes, as you can probably tell by the color, leeks, and
      garlic.
    ScreenActions:
    - rid: 268099999270699012
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Advanced tomato soup, eh?
    ScreenActions:
    - rid: 268099999270699013
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Can't go wrong with that, I guess...
    ScreenActions:
    - rid: 268099999270699014
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Hulda, could I get some of that stew, too?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 450344c00cea1104f9790b62b46ab3b1, type: 2}
    dialog: Sure thing, that'll be 5 septims.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I hand over the gold and in return receive a bowl-full of...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Huh. You know, the ingredient line-up screams Italian, but obviously
      the Nords are inspired by... well, the Norse.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Whatever the case, it tastes good so I can forgive the curious amalgamation
      of cultures.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Mmm... yummy!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Oh yeah, I should probably ask Monika about that-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Monika, you're the captain of the guard here, right?
    ScreenActions:
    - rid: 268099999270699015
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Huh? Oh, yeah, that's right.
    ScreenActions:
    - rid: 268099999270699016
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Good, 'cause I'll need your help to trap a dragon in Dragonsreach.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh... how?
    ScreenActions:
    - rid: 268099999270699017
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 268099999270699018
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
