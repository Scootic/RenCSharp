%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: StinkyMonikaDepreMc
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Wow, you look like crap!
    ScreenActions:
    - rid: 1790118425451561113
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Not in the mood?
    ScreenActions:
    - rid: 1790118425451561114
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I understand, suddenly realizing your whole existence is a lie is quite
      the trip.
    ScreenActions:
    - rid: 1790118425451561115
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: How... how do you know about that?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: That feeling? Or how that was what you're going through right now?
    ScreenActions:
    - rid: 1790118425451561117
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: The latter is because <b>they</b> told me, I assume you've met by now?
    ScreenActions:
    - rid: 1790118425451561118
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... yeah.
    ScreenActions:
    - rid: 1790118425451561119
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Now, the reason I know about that feeling is because I've gone through
      it myself!
    ScreenActions:
    - rid: 1790118425451561120
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... what?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yep! Back home I learned that our lives were all just a lie, all some
      game.
    ScreenActions:
    - rid: 1790118425451561121
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So, I knew about it before you did!
    ScreenActions:
    - rid: 1790118425451561122
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: In fact, I did try asking you about it, since you said some things that
      were...
    ScreenActions:
    - rid: 1790118425451561123
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Off-script is the best way to put it?
    ScreenActions:
    - rid: 1790118425451561124
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Since, you know, different {mc}.
    ScreenActions:
    - rid: 1790118425451561125
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I do remember you being a bit... off.
    ScreenActions:
    - rid: 1790118425451561127
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Being self-aware is probably why I seemed that way.
    ScreenActions:
    - rid: 1790118425451561129
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Anyway, you don't really have a reason to be so gloomy.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 1790118425451561130
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh... you disagree?
    ScreenActions:
    - rid: 1790118425451561131
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Of course I disagree!!! How could you not understand?!?
    ScreenActions:
    - rid: 1790118425451561132
    - rid: 1790118425451561133
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Not only am I fake, I'm not even a real fake!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
