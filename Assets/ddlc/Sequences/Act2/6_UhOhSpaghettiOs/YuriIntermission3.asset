  m_Name: YuriIntermission3
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118559174885584
    - rid: 1790118559174885585
    - rid: 1790118559174885586
    - rid: 1790118559174885587
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Phew... it's been a long, but fulfilling, day of studying.)
    ScreenActions:
    - rid: 1790118559174885588
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (While I would've liked to dive deeper into the ramifications of the
      birthsigns-)
    ScreenActions:
    - rid: 1790118559174885589
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (<i>Especially</i> the Serpent-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (I need to get my rest for tomorrow.)
    ScreenActions:
    - rid: 1790118559174885590
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (I should check in with Sayori one last time before I head to bed for
      the night.)
    ScreenActions:
    - rid: 1790118559174885591
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118559174885592
    - rid: 1790118559174885593
    - rid: 1790118559174885605
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Oh? Sayori's still asleep.)
    ScreenActions:
    - rid: 1790118583906598912
    - rid: 1790118583906598913
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (I should check her temperature.)
    ScreenActions:
    - rid: 1790118583906598914
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri walks over to Sayori's bedside and places her hand gently onto Sayori's
      forehead, as to not wake her.
    ScreenActions:
    - rid: 1790118583906598915
    - rid: 1790118583906598916
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Hm... she doesn't seem to be <i>that</i> hot-)
    ScreenActions:
    - rid: 1790118583906598917
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Zzzz...
    ScreenActions:
    - rid: 1790118583906598918
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Just a snore, nothing to worry about.)
    ScreenActions:
    - rid: 1790118583906598919
    - rid: 1790118583906598920
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Hopefully you'll be better by tomorrow, Sayori.)
    ScreenActions:
    - rid: 1790118583906598921
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118583906598922
    - rid: 1790118583906598923
    - rid: 1790118583906598924
    - rid: 1790118583906598925
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 1790118583906598926
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Ahh... that's a load off of my back...)
    ScreenActions:
    - rid: 1790118583906598927
    - rid: 1790118583906598928
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (I swear, these beds have to be enchanted; I doubt the avaliable materials
      like hay would be this supportive <i>and</i> malleable.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
