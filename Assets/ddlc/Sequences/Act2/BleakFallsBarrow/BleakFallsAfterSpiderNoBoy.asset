  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: BleakFallsAfterSpiderNoBoy
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475098267418919
    - rid: 9079475098267418920
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Take that, you eight-legged punk!
    ScreenActions:
    - rid: 9079474864314122459
    - rid: 9079474864314122460
    - rid: 9079474864314122461
    - rid: 9079474864314122463
    - rid: 9079475089592287539
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You don't need to worry anymore, {mc}, we took care of that big mean
      spider for you!
    ScreenActions:
    - rid: 9079474864314122464
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... eh, wha-?
    ScreenActions:
    - rid: 9079475098267418921
  - speaker: {fileID: 0}
    dialog: Sure enough, the Giant Frostbite Spider lies dead.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Which is still freaky, but certainly more manageable.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I-I-I, uhh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: S-sorry...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: It's okay, {mc}. There are just some things that a person cannot do,
      and that's okay.
    ScreenActions:
    - rid: 9079474864314122466
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Besides, you've been doing a great job keeping us safe so far, so it's
      only right that we return the favor!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: C'mon, {mc}. We took care of the big bad spider, what's next?
    ScreenActions:
    - rid: 9079474864314122467
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Ah... right...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Well, what's next is Arvel.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
