  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: BleakFallsSpiderWithoutBoy
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Alright.)
    ScreenActions:
    - rid: 9079474884650467404
    - rid: 9079474884650467405
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We're gonna have to take on that thing without {mc}.
    ScreenActions:
    - rid: 9079474864314122392
    - rid: 9079474864314122393
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Do you really think we can?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We don't have a choice, so we <i>will</i>.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Natsuki, since you actually have armor, you're going to take it head
      on with me.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Seriously?
    ScreenActions:
    - rid: 9079474864314122420
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What, don't tell me you're scared of spiders, too?
    ScreenActions:
    - rid: 9079474864314122421
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We only get one, you know.
    ScreenActions:
    - rid: 9079474864314122422
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: You're trying to piss me off, aren't you?
    ScreenActions:
    - rid: 9079474864314122423
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What? Nooo~
    ScreenActions:
    - rid: 9079474864314122424
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: But if I am pissing you off, you should take that anger out on <i>it</i>,
      yeah?
    ScreenActions:
    - rid: 9079474864314122425
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: <font=futura>Natsuki scoffs.
    ScreenActions:
    - rid: 9079474864314122426
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yuri, you use that magic dagger of yours to stab it from the side while
      we're distracting it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (I got this, I got this...)
    ScreenActions:
    - rid: 9079474864314122427
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Do it for {mc}, do it for {mc}...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Sayori, you-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hang back and make sure {mc} is okay...?
    ScreenActions:
    - rid: 9079474864314122428
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474864314122429
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: No, we'll need your help fighting this thing too.
    ScreenActions:
    - rid: 9079474864314122430
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ... okay...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Okay, everyone!
    ScreenActions:
    - rid: 9079474864314122431
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We are <i>murdering</i> this spider!
    ScreenActions:
    - rid: 9079474864314122438
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
