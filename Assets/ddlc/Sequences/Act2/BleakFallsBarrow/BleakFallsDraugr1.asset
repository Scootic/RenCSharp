%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: BleakFallsDraugr1
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: The four of us make our way to the exit, which just so happens to have
      a dark elf webbed up in the way.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: You did it. You killed it. Now cut me down-
    ScreenActions:
    - rid: 9079474884650467406
    - rid: 9079474884650467407
    - rid: 9079474884650467408
    - rid: 9079474884650467409
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Nope.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Wha- what do you mean no?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Because when we cut you down, you'll just run away.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Uh, is that really a bad thing, {mc}?)
    ScreenActions:
    - rid: 9079474884650467328
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: No, no, no why would I run away? I would thank you!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, right.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Or, maybe, you would run away claiming that the claw is "yours" and that
      it wouldn't make sense to share it with anybody.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Uh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Or is that wrong, Mr. Swift?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Look, just cut me down, and I'll-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Where are you keeping it?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Huh?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Which pocket is the claw in?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (The claw?)
    ScreenActions:
    - rid: 9079474884650467329
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: As if I would tell you-!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Er!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh? Why are you so worried about me knowing the claw's whereabouts?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Worried I'll take it?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I thought so.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, look.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: In case you haven't noticed, you are completely restrained, and there
      are five of us, <i>and</i> we're armed.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You can see where this is going, right?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: ...!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You're gonna stay silent? You want me to spell it out for everyone here?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'Whatever, you have two choices:'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You hand over the claw, we cut you down, you get to leave this place
      with your life.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Or, you don't hand over the claw, and we leave you tied up. Your choice.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ({mc}, would it really be okay to leave him here?)
    ScreenActions:
    - rid: 9079474884650467330
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: We stare him down for about a minute.
    ScreenActions:
    - rid: 9079474884650467331
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, bye. Enjoy starving to death.
    ScreenActions:
    - rid: 9079474884650467332
    - rid: 9079474884650467333
    - rid: 9079474884650467334
    - rid: 9079474884650467335
  - speaker: {fileID: 0}
    dialog: I turn around and start heading in the direction we came-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: Wait!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I look back to Arvel, but let him continue.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b8758bd5240c804cba320aae0de1d14, type: 2}
    dialog: ... it's in my back pocket...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I see.
    ScreenActions:
    - rid: 9079474884650467336
    - rid: 9079474884650467337
  - speaker: {fileID: 0}
    dialog: I make my way to the webbed Arvel, and slice my way toward his back pocket,
      deliberately leaving his limbs restrained.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: With a path excavated, I dig through his pocket and find the claw.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Which I successfully take from Arvel.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, I'm cutting you down now.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Remember, you are heavily out-numbered and out-armed, before you get
      any bright ideas.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I slice Arvel down.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: He looks at me with fury in his eyes, but-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: He runs away, toward the entrance of the barrow.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'Huh. '
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Honestly, I kind of expected him to put up some sort of fight like an
      idiot.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The characters in the actual game have a very poor sense of self-preservation,
      especially when it comes to fighting literal legends.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, let's get moving-
    ScreenActions:
    - rid: 9079474884650467410
    - rid: 9079474884650467411
    - rid: 9079474884650467412
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Um, {mc}?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: What's so important about that gold claw that you had to threaten that
      man?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, we're going to need it to get the Dragonstone.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Besides, the claw wasn't Arvel's to begin with.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm pretty sure it belongs here as a cultural artifact if you want to
      be anal about it...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: But Arvel stole it from a shop in Riverwood before coming here.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Are we going to give it back once we're done with it?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I think there's like 100 septims involved with that, so yes.
    ScreenActions:
    - rid: 9079474884650467413
  - speaker: {fileID: 0}
    dialog: We delve ever deeper into the barrow.
    ScreenActions:
    - rid: 9079474884650467414
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Hold up.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (What's up, {mc}?)
    ScreenActions:
    - rid: 9079474884650467415
    - rid: 9079474884650467416
    - rid: 9079474884650467417
    - rid: 9079474884650467418
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (You see that portruding patterned stone over there?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (Yeah?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Don't step on that. It'll make a spiked wall slam into you, which will
      probably hurt.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Well, alright then let's-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (That's not all, we've finally reached the draugr.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (The zombie-thingies?)
    ScreenActions:
    - rid: 9079474884650467419
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (The very same, so-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (U-um, {mc}?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (What is it, Yuri?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (What are draugr, really?)
    ScreenActions:
    - rid: 9079474884650467420
    - rid: 9079474884650467421
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Well!)
    ScreenActions:
    - rid: 9079474884650467422
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Long, long ago, thousands of years ago!)
    ScreenActions:
    - rid: 9079474884650467425
    - rid: 9079474884650467430
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I'm pretty sure it was the Merethic era... or was it before?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Anyway! In those ancient times, the dragons ruled Skyrim.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (And also Atmora, I think? But that's a whole other thing.)
    ScreenActions:
    - rid: 9079474884650467423
    - rid: 9079474884650467424
    - rid: 9079474884650467426
    - rid: 9079474884650467431
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (So, obviously, the dragons basically had humanity enslaved.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Some people weren't fans of that, but others were willing to work alongside
      the dragons in exchange for having power over their fellows.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (So, these loyal individuals were a part of the dragon cult, which worshipped
      and served the dragons.)
    ScreenActions:
    - rid: 9079474884650467432
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Now, the dragons did give... something resembling boons to these faithful.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (The dragon priests, who were basically the closest a human could get
      to being on par with a dragon in terms of social strata-)
    ScreenActions:
    - rid: 9079474884650467427
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (They had incredible magical power and often ruled the people on behalf
      of their dragon overlords.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Now, the dragons are immortal beings- they can only be killed by another
      dragon or a dragonborn, remember?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Which meant that their servants would inevitably die, and be unable
      to serve their masters anymore.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (In response, the dragons used their powers to curse their followers
      with undeath.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (These undead followers are now known as the draugr, who speak the dragon
      language and attack anyone who disturbs their tombs.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Are you done?!?
    ScreenActions:
    - rid: 9079474884650467428
    - rid: 9079474884650467429
    - rid: 9079474884650467433
    - rid: 9079474884650467434
    - rid: 9079474884650467435
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: All of the draugr in the room begin stirring.
    ScreenActions:
    - rid: 9079474884650467436
    - rid: 9079474884650467437
    - rid: 9079474884650467438
    - rid: 9079474884650467439
  - speaker: {fileID: 0}
    dialog: ... I'm very upset.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Natsuki, sweetie, if you really wanted to me stop...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: YOU SHOULD HAVE JUST SAID SO!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Well, you decided to-
    ScreenActions:
    - rid: 9079474884650467440
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: We're not doing this <i>right now</i>, you idiot!
    ScreenActions:
    - rid: 9079474884650467441
    - rid: 9079474884650467442
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: What we <i>are</i> doing, is booking it!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Watch your step~!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Following my lead, the other four start running.
    ScreenActions:
    - rid: 9079474884650467443
    - rid: 9079474884650467444
    - rid: 9079474884650467445
    - rid: 9079474884650467446
  - speaker: {fileID: 0}
    dialog: Luckily, the draugr take a lot of time to wake up, so we are able to
      get some distance-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: A-aah!
    ScreenActions:
    - rid: 9079474884650467447
    - rid: 9079474884650467448
    - rid: 9079474884650467449
    - rid: 9079474884650467450
    - rid: 9079474884650467451
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Ah, you gotta be-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Fuck it!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I turn around to go pick up Yuri.
    ScreenActions:
    - rid: 9079474884650467452
    - rid: 9079474884650467453
    - rid: 9079474884650467454
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Monika! You keep leading the other two, watch out for swinging axes from
      the wall!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Alright, {mc}!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I manage to get Yuri on her feet, but by then the draugr have already
      closed the distance to us.
    ScreenActions:
    - rid: 9079474884650467457
  - speaker: {fileID: 0}
    dialog: An ancient nordic axe swings past my face-!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474884650467459
  - speaker: {fileID: 0}
    dialog: A stronger draugr blasts some frost at us!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474884650467460
  - speaker: {fileID: 0}
    dialog: We manage to escape the draugr...
    ScreenActions:
    - rid: 9079474884650467461
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474884650467462
    - rid: 9079474884650467466
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: '{mc}, Yuri, are you okay?'
    ScreenActions:
    - rid: 9079474884650467463
    - rid: 9079474884650467465
    - rid: 9079474884650467467
    - rid: 9079474884650467468
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474884650467471
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079474884650467473
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Th-thanks for coming back for me, {mc}...
    ScreenActions:
    - rid: 9079474884650467475
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (... no greater a romantic gesture than to-)
    ScreenActions:
    - rid: 9079474884650467476
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, duh. No man (or woman) left behind.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Natsuki can't seem to look me in the eyes.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Two outbursts in one day... just great.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: It's not like I don't understand her frustration. I really do...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: It's just that-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Gah! No one else has this problem! Why do you have to be like this, Natsuki!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: <b>If your dad hits you, he should do it harder</b>-!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ... ah... that's <i>cruel</i>...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: We're taking a break.
    ScreenActions:
    - rid: 9079474884650467477
    - rid: 9079474884650467478
    - rid: 9079474884650467479
    - rid: 9079474884650467484
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: That's probably for the best, {mc}.
    ScreenActions:
    - rid: 9079474884650467480
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: And hey!
    ScreenActions:
    - rid: 9079474884650467481
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: We get to enjoy the relaxing sounds of a waterfall while we rest, isn't
      that nice?
    ScreenActions:
    - rid: 9079474884650467482
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, you're right!
    ScreenActions:
    - rid: 9079474884650467483
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: It sounds kind of like the stuff I listen to that helps me sleep at night!
    ScreenActions:
    - rid: 9079474884650467485
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: You have trouble sleeping at night, Sayori?
    ScreenActions:
    - rid: 9079474884650467486
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ehehe... maybe just a little...
    ScreenActions:
    - rid: 9079474884650467487
  - speaker: {fileID: 0}
    dialog: I plop my butt down on a comfy looking rock.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh, speaking of sleep, we should probably figure that out.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Even though the Skyrim housing market is better than our own, it's not
      like they come cheap.
    ScreenActions:
    - rid: 9079474884650467488
    - rid: 9079474884650467489
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The cheapest one is Breezehome in Whiterun for 5000 septims.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ... so around ten times the amount of money we currently have?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Money doesn't come as easy in the early-game, but even if we <i>did</i>
      buy Breezehome...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: It probably wouldn't be big enough for the five of us.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: <i>Especially</i> when you first purchase it without any additional customizations.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What about inns? How expensive are those?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, there's a bunch of inns around Skyrim, and every single one has
      a price of 10 septims to rent a room for a day.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So the economics are certainly better, but it's not a permanent solution.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Besides, I'm pretty sure that most inns might not have enough for all
      of us to have our own room.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah, that's fine. We can share!
    ScreenActions:
    - rid: 9079474884650467490
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh- what?
    ScreenActions:
    - rid: 9079474884650467491
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: It'll be like a big sleepover!
    ScreenActions:
    - rid: 9079474884650467492
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sayori, you know that we're adults now, right?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Adults can't have sleepovers?
    ScreenActions:
    - rid: 9079474884650467493
  - speaker: {fileID: 0}
    dialog: ... I'm pretty sure those are just crocodile tears-
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Wait, what's up with Yuri?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I mean, adults can have sleepovers, but men and women shouldn't because...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You know...?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...!
    ScreenActions:
    - rid: 9079474884650467494
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ehehe... I guess you're right...
    ScreenActions:
    - rid: 9079474884650467495
    - rid: 9079474884650467496
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: But, there's nothing stopping us girls from sharing, right?
    ScreenActions:
    - rid: 9079474884650467497
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: If we split off into pairs, then we would only need to get three rooms.
    ScreenActions:
    - rid: 9079474884650467498
    - rid: 9079474884650467499
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Would that work?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: For most inns, probably!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... well that's sorted now, I guess.
    ScreenActions:
    - rid: 9079474884650467500
  - speaker: {fileID: 0}
    dialog: ... Natsuki had drifted to a corner of the room while we were talking.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Hmm.
    ScreenActions:
    - rid: 9079474884650467501
    - rid: 9079474884650467502
    - rid: 9079474884650467503
  - speaker: {fileID: 0}
    dialog: We laze around for about an hour.
    ScreenActions:
    - rid: 9079474884650467504
  - speaker: {fileID: 0}
    dialog: I think? It's like any of us has a watch.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I get up from my rock.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, we should probably get moving again.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, {mc}? Friend? Bestest buddy of mine?
    ScreenActions:
    - rid: 9079474884650467505
    - rid: 9079474884650467506
    - rid: 9079474884650467507
    - rid: 9079474884650467508
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You hungry?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yeah-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Wait, how did you know?!?
    ScreenActions:
    - rid: 9079474884650467509
  - speaker: {fileID: 0}
    dialog: Other than you always being down for a snack?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I can think of few other things you would ask for with so many appeals
      to the depth of our friendship.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hmph!
    ScreenActions:
    - rid: 9079474884650467510
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You want some cabbage that's been in a bag for a few hours?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uhh...
    ScreenActions:
    - rid: 9079474884650467511
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Because that's what I got.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: We should've stocked up on snacks before we left!
    ScreenActions:
    - rid: 9079474884650467512
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Too late to worry about that now, you want the cabbage or no?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079474884650467513
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Fine!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I'll take some stupid cabbage...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I tear off some of the leaves of my cabbage and give them to Sayori.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Huh.
    ScreenActions:
    - rid: 9079474884650467515
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I kinda thought it would be all wrinkly and stale by now...
    ScreenActions:
    - rid: 9079474884650467516
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: But it wasn't <i>that</i> bad!
    ScreenActions:
    - rid: 9079474884650467517
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That's nice, Sayori.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ... can I have some?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
