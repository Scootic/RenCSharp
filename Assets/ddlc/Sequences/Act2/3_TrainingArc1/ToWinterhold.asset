    - rid: 4351267832094261355
    - rid: 4351267832094261356
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, isn't that Windham; that city {mc} was talking about?
    ScreenActions:
    - rid: 4351267832094261357
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
