    ScreenActions:
    - rid: 4351268099428974755
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (There has to be some other-)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
