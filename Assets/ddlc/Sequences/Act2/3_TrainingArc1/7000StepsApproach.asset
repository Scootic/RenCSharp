  m_Name: 7000StepsApproach
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475250346852483
    - rid: 9079475250346852484
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh, look Monika, we can see Ivarstead from here.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Neat!
    ScreenActions:
    - rid: 9079475250346852486
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, {mc}?
    ScreenActions:
    - rid: 9079475250346852543
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah?
    ScreenActions:
    - rid: 9079475250346852544
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Now that we're a bit closer...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Are we really climbing up that whole mountain?
    ScreenActions:
    - rid: 9079475250346852545
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Look, I'm not exactly a fan of extended labor like this either-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: But at least we don't have to literally climb it; in fact, we straight-up
      get stairs!
    ScreenActions:
    - rid: 9079475250346852546
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Uh, we should have lunch first, {mc}.
    ScreenActions:
    - rid: 9079475250346852547
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Monika?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Yeah?
    ScreenActions:
    - rid: 9079475250346852548
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That is an <i>excellent</i> idea. Wonderful, even.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: The two of us head into the nearby inn for a place to sit while we have
      lunch.
    ScreenActions:
    - rid: 9079475250346852549
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
