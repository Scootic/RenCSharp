  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: companionquest3
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268055900487845
    - rid: 4351268055900487846
    - rid: 4351268055900487847
    - rid: 4351268055900487848
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Haahh... haahh... was that the last one, Farkas?
    ScreenActions:
    - rid: 4351268055900487849
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I think so... yeah...
    ScreenActions:
    - rid: 4351268055900487850
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Farkas reverts from his werewolf form now that all of the draugr lie
      dead.
    ScreenActions:
    - rid: 4351268055900487851
    - rid: 4351268055900487863
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: So, uh, do we gotta walk all the way back to the entrance now?
    ScreenActions:
    - rid: 4351268055900487853
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Usually these old Nordic tombs loop around so that these central chambers
      aren't too far from the entrance.
    ScreenActions:
    - rid: 4351268055900487854
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Uh, why?
    ScreenActions:
    - rid: 4351268055900487855
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: That way, in times of trouble, it would be easier to escape.
    ScreenActions:
    - rid: 4351268055900487856
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Escape what?
    ScreenActions:
    - rid: 4351268055900487857
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Invading armies and the like.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Huh...
    ScreenActions:
    - rid: 4351268055900487858
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The two of them begin looking for the alleged shorter path back to the
      entrance.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: This it?
    ScreenActions:
    - rid: 4351268055900487859
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Probably.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268055900487860
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I guess you were right, Farkas.
    ScreenActions:
    - rid: 4351268055900487861
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Let's get back to Jorrvaskr, Shield-Sister.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah.
    ScreenActions:
    - rid: 4351268055900487862
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
