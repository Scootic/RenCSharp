  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: collegequest1
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267917689782439
    - rid: 4351267917689782440
    - rid: 4351267917689782458
    - rid: 4351267917689782459
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah...
    ScreenActions:
    - rid: 4351267917689782442
    - rid: 4351267917689782443
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: That hit the spot!
    ScreenActions:
    - rid: 4351267917689782444
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Now, let's go do some learneding, Yuri!
    ScreenActions:
    - rid: 4351267917689782445
    - rid: 4351267917689782446
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ... yeah.
    ScreenActions:
    - rid: 4351267917689782447
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267917689782448
    - rid: 4351267917689782449
    - rid: 4351267917689782450
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Cross the bridge at your own peril!
    ScreenActions:
    - rid: 4351267917689782451
    - rid: 4351267917689782452
    - rid: 4351267917689782454
    - rid: 4351267917689782455
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: The way is dangerous, and the gate will not open.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: You shall not gain entry!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Um, who are you miss?
    ScreenActions:
    - rid: 4351267917689782456
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: I am Faralda, one of the senior wizards here.
    ScreenActions:
    - rid: 4351267943501266944
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Now, I must advise you that, if your only purpose in being here is to
      complain, you would be far better of talking to the Jarl-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, Ms. Faralda, we're here to join enroll here at the college. Is that
      okay?
    ScreenActions:
    - rid: 4351267943501266945
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Oh...!
    ScreenActions:
    - rid: 4351267943501266946
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Well, for what purpose do you seek to enter the college?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh...
    ScreenActions:
    - rid: 4351267943501266947
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Yuri, what kind of magic did {mc} say I used again?)
    ScreenActions:
    - rid: 4351267943501266948
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Restoration, Sayori.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Thanks!)
    ScreenActions:
    - rid: 4351267943501266949
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I want to improve my Restoration spells, Ms. Faralda!
    ScreenActions:
    - rid: 4351267943501266962
    - rid: 4351267943501266963
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: ... I see...
    ScreenActions:
    - rid: 4351267943501266964
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: And what about you?
    ScreenActions:
    - rid: 4351267943501266965
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Well...
    ScreenActions:
    - rid: 4351267943501266966
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: There is much I want to learn-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: The mysteries of Aetherius and the Divines, Oblivion and the Princes,
      and the very firmament-
    ScreenActions:
    - rid: 4351267943501266967
    - rid: 4351267943501266968
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Uh, are you familiar with any schools of magic already?
    ScreenActions:
    - rid: 4351267943501266969
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: I know some basic Conjuration.
    ScreenActions:
    - rid: 4351267943501266970
    - rid: 4351267943501266971
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Very well, please demonstrate what you can do.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: With a simple motion of her hands, Yuri summons a dagger from Oblivion.
    ScreenActions:
    - rid: 4351267943501267067
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: I see, what about you?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh... well, I'll need a hurt person first...
    ScreenActions:
    - rid: 4351267943501266972
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Ah, of course.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Faralda raises her hand and fires a small fireball at Yuri.
    ScreenActions:
    - rid: 4351267943501266973
    - rid: 4351267943501266974
    - rid: 4351267943501266984
    - rid: 4351267943501266985
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori quickly goes over to Yuri, attempting to heal her.
    ScreenActions:
    - rid: 4351267943501266975
    - rid: 4351267943501266977
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: And she does! The little singes on Yuri's skin, and the pain, quickly
      fade away.
    ScreenActions:
    - rid: 4351267943501266976
    - rid: 4351267943501266978
    - rid: 4351267943501266979
    - rid: 4351267943501267066
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Why'd you do that-!
    ScreenActions:
    - rid: 4351267943501266980
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: You said you needed someone to be injured.
    ScreenActions:
    - rid: 4351267943501266981
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: Besides, I didn't do any major damage and there's plenty of healers that
      I could call upon in the event your skills were not adequate.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: The both of you have passed my tests.
    ScreenActions:
    - rid: 4351267943501266982
  - speaker: {fileID: 11400000, guid: 3b9d3d794309e1848a67c6a6897eddf2, type: 2}
    dialog: You may now head down the bridge toward the college; please speak to
      Mirabelle Ervine, our Master Wizard, when you arrive.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Faralda steps out of the way to let the two girls through to the college.
    ScreenActions:
    - rid: 4351267943501266983
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267943501267038
    - rid: 4351267943501267039
    - rid: 4351267943501267044
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Excuse me, are you Ms. Ervine?
    ScreenActions:
    - rid: 4351267943501267045
    - rid: 4351267943501267041
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: I am Mirabelle Ervine, the Master Wizard here, yes.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: Do you two need something?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well, we're new students here, and Ms. Faralda told us to come see you.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: Ah, I see, follow me. I'll give you a brief tour of our facilities.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: First, she shows off the sleeping quarters.
    ScreenActions:
    - rid: 4351267943501267046
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Then, the main hall.
    ScreenActions:
    - rid: 4351267943501267047
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: And finally, the library.
    ScreenActions:
    - rid: 4351267943501267048
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: Alright you two, if you have any questions, feel free to ask any of the
      staff here.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: But don't bother the archmage, if you have a question for him it's better
      to go through me first.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: Tolfdir should be giving out a lecture with the other new students down
      in the Hall of Elements, so you should probably attend that.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 251ab17588978ca44861c552397cfd18, type: 2}
    dialog: Welcome to the College of Winterhold.
    ScreenActions:
    - rid: 4351267943501267049
    - rid: 4351267943501267050
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Our first college lecture...
    ScreenActions:
    - rid: 4351267943501267051
    - rid: 4351267943501267052
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I'm so <SineText=4>excited</SineText>~!
    ScreenActions:
    - rid: 4351267943501267053
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Let's go, Yuri.
    ScreenActions:
    - rid: 4351267943501267055
    - rid: 4351267943501267056
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Welcome, welcome! We were just beginning. Please, stay and listen.
    ScreenActions:
    - rid: 4351267943501267057
    - rid: 4351267943501267058
    - rid: 4351267943501267059
    - rid: 4351267943501267060
    - rid: 4351267943501267061
    - rid: 4351267943501267062
    - rid: 4351267943501267063
    - rid: 4351267943501267064
    - rid: 4351267943501267065
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: So, as I was saying, the first thing to understand is that magic is,
      by its very nature, volatile and dangerous.
    ScreenActions:
    - rid: 4351267943501267070
    - rid: 4351267943501267071
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Unless you can control it, it can and will destroy you.
    ScreenActions:
    - rid: 4351267943501267072
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: Sir, I think we all understand that fairly well.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: We wouldn't be here if we couldn't control magic!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Of course, my dear, of course.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: You all certainly posses some inherent natural ability. That much is
      not being questioned.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: 'What I''m talking about is true control, mastery of magic. It takes
      years, if not decades, of practice and study. '
    ScreenActions:
    - rid: 4351267943501267074
    - rid: 4351267943501267075
  - speaker: {fileID: 11400000, guid: 15749674ba4a7a9428fe9cc574046344, type: 2}
    dialog: Then what are we waiting for? Let's get started!
    ScreenActions:
    - rid: 4351267943501267076
    - rid: 4351267943501267077
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (Holy crap Yuri, is that person a cat?!?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (... huh!)
    ScreenActions:
    - rid: 4351267943501267078
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Perhaps that is some form of native person here on Tamriel...)
    ScreenActions:
    - rid: 4351267943501267079
    - rid: 4351267943501267081
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (It would probably be best to ask {mc} about it-)
    ScreenActions:
    - rid: 4351267943501267080
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: You two have been quiet so far, what do you think we should do?
    ScreenActions:
    - rid: 4351267943501267082
    - rid: 4351267943501267083
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Uuhhh...
    ScreenActions:
    - rid: 4351267943501267084
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh...
    ScreenActions:
    - rid: 4351267943501267085
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: We should, uh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Learn a spell about it...?
    ScreenActions:
    - rid: 4351267943501267086
    - rid: 4351267943501267087
  - speaker: {fileID: 11400000, guid: 15749674ba4a7a9428fe9cc574046344, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 4c9db5d4425cb424da7340fe5fac55ca, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267943501267089
  - speaker: {fileID: 11400000, guid: 6ce26110965197241908f3f9f7ef5410, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267943501267090
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: ... is that so?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: I suppose we could try something practical...
    ScreenActions:
    - rid: 4351267943501267091
    - rid: 4351267943501267092
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: In continuation of our theme of safety, we'll start with wards.
    ScreenActions:
    - rid: 4351267943501267093
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Wards are protective spells that can block magic. I'll teach you all
      a ward, and we'll see if you can successfully block spells, all right?
    ScreenActions:
    - rid: 4351267943501267094
    - rid: 4351267943501267097
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Tolfdir turns to Sayori.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Would you mind helping me with the demonstration? Are you at all familiar
      with ward spells?
    ScreenActions:
    - rid: 4351267943501267098
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, I don't know any ward spells, Mr. Tolfdir...
    ScreenActions:
    - rid: 4351267943501267099
    - rid: 4351267943501267100
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: That's all right. I can teach you a very basic ward, one that's enough
      for the purposes of our lesson.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Tolfdir begins teaching Sayori how to cast the Lesser Ward spell.
    ScreenActions:
    - rid: 4351267943501267101
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Surprisingly, it is very simple so Sayori is able to replicate it pretty
      quickly.
    ScreenActions:
    - rid: 4351267943501267102
    - rid: 4351267943501267104
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri tries to replicate the process herself, but isn't able to fully
      form the ward like Sayori.
    ScreenActions:
    - rid: 4351267943501267105
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Now, if you'll just stand over there-
    ScreenActions:
    - rid: 4351267943501267106
    - rid: 4351267943501267107
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Okay~!
    ScreenActions:
    - rid: 4351267943501267108
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori moves to where Tolfdir was pointing, directly across from him.
    ScreenActions:
    - rid: 4351267943501267109
    - rid: 4351267943501267110
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Now, cast the ward spell and keep it up...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori raises her ward, putting all of her energy into maintaining it.
    ScreenActions:
    - rid: 4351267943501267111
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: When can I stop, Mr. Tolfdir-?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ah!
    ScreenActions:
    - rid: 4351267943501267112
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Tolfdir threw a firebolt directly at Sayori's ward, which successfully
      nullified the attack.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: (What is up with these teachers throwing fireballs at us, Yuri?!?)
    ScreenActions:
    - rid: 4351267943501267113
    - rid: 4351267943501267114
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ({mc} did say that the college leadership was a bit incompetent, perhaps
      this is what he meant by that...)
    ScreenActions:
    - rid: 4351267943501267115
    - rid: 4351267943501267116
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Excellent work!
    ScreenActions:
    - rid: 4351267943501267117
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Well, I think this is a good start.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: I'd like for you all to continue practicing with wards.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: I think perhaps we're ready to begin exploring some of the various applications
      of magic throughout history.
    ScreenActions:
    - rid: 4351267943501267118
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: The college has undertaken a fascinating excavation in the ruins of Saarthal
      nearby-
    ScreenActions:
    - rid: 4351267943501267119
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: It's an excellent learning opportunity.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: I suggest we meet there in a few hours, and see what awaits us inside.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: That's all for now, thank you.
    ScreenActions:
    - rid: 4351267943501267120
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Everyone begins filing out of the Hall of Elements, now that Tolfdir's
      lecture is officially over.
    ScreenActions:
    - rid: 4351267943501267121
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Well...
    ScreenActions:
    - rid: 4351267943501267122
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Now what?
    ScreenActions:
    - rid: 4351267943501267123
    - rid: 4351267943501267124
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Hmm...
    ScreenActions:
    - rid: 4351267943501267125
    - rid: 4351267943501267126
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: I'm going up to the Arcanaeum to do some reading.
    ScreenActions:
    - rid: 4351267943501267127
    - rid: 4351267943501267128
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267943501267129
    - rid: 4351267943501267130
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I think I'll take a nap until it's time to go...
    ScreenActions:
    - rid: 4351267943501267131
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Could you please wake me up if I'm not up by then?
    ScreenActions:
    - rid: 4351267943501267133
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Of course, Sayori.
    ScreenActions:
    - rid: 4351267943501267135
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori heads to the Hall of Attainment to get her rest.
    ScreenActions:
    - rid: 4351267943501267136
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267943501267137
    - rid: 4351267943501267138
    - rid: 4351267943501267140
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Excuse me, are you the librarian here?
    ScreenActions:
    - rid: 4351267943501267141
    - rid: 4351267943501267142
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: That's right. Do you need help looking for a specific book?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Do you have anything on telepathy? Being able to communicate directly
      to someone's mind even across vast distances?
    ScreenActions:
    - rid: 4351267943501267143
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: Hrm. That's some advanced magic for a new apprentice...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: Well, <i>The Doors of Oblivion</i> features a master and apprentice communicating
      from Oblivion to Nirn...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: You'll want to look into the Psijic Order, which can project themselves
      across vast distances...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: You can also speak to Phinis Gestor, our resident master of Conjuration.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Thank you, Mr...
    ScreenActions:
    - rid: 4351267943501267144
  - speaker: {fileID: 11400000, guid: 9a5ea5c94adebd840ac464dd04a1ceae, type: 2}
    dialog: Urag gro-Shub.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Thank you, Mr. gro-Shub.
    ScreenActions:
    - rid: 4351267943501267145
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: With a starting point found, Yuri grabs a copy of <i>The Doors of Oblivion</i>
      and sits down to read.
    ScreenActions:
    - rid: 4351267943501267146
    - rid: 4351267943501267147
    - rid: 4351267943501267148
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri reads the book...
    ScreenActions:
    - rid: 4351267943501267149
    - rid: 4351267943501267150
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: As Yuri closes the book, she realizes that she needs to go wake up Sayori
      if they want to make it to Saarthal on time.
    ScreenActions:
    - rid: 4351267943501267152
    - rid: 4351267943501267153
    - rid: 4351267943501267161
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Or, at the very least, she assumes so.
    ScreenActions:
    - rid: 4351267943501267154
    - rid: 4351267943501267159
    - rid: 4351267943501267162
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267943501267156
    - rid: 4351267943501267157
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Sayori, wake up!
    ScreenActions:
    - rid: 4351267943501267155
    - rid: 4351267943501267160
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Nvrinamillonyeearrs!!!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: I'm serious, we need to leave now...!
    ScreenActions:
    - rid: 4351267943501267164
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Imjussaseepeegorl...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: You need to get up, Sayori!
    ScreenActions:
    - rid: 4351267943501267165
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri begins jostling Sayori in attempt to get her up.
    ScreenActions:
    - rid: 4351267943501267166
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Aaaaah!
    ScreenActions:
    - rid: 4351267943501267167
    - rid: 4351267943501267168
    - rid: 4351267943501267169
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Huh-?
    ScreenActions:
    - rid: 4351267943501267170
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Why'd you wake me up-!
    ScreenActions:
    - rid: 4351267943501267171
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Because we need to go now!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267943501267172
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Then let's go, Yuri!
    ScreenActions:
    - rid: 4351267943501267173
    - rid: 4351267943501267174
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Haaaahh...
    ScreenActions:
    - rid: 4351267943501267175
