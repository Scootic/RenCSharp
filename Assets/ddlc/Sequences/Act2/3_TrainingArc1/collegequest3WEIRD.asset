    - rid: 4351268055900487784
    - rid: 4351268055900487785
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You took that guy down all by yourself, Yu-?
    ScreenActions:
    - rid: 4351268055900487786
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
