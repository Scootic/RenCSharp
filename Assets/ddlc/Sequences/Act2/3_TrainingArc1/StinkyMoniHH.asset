%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: StinkyMoniHH
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Did <b>you</b> miss me, too?)
    ScreenActions:
    - rid: 4351267874930425930
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: I've been watching you, so no?
    ScreenActions:
    - rid: 4351267874930425957
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: '(Hmph! That''s the part where <b>you''re</b> supposed to say: "yes,
      I''ve missed you a lot.")'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Uh, Monika?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Yeah?)
    ScreenActions:
    - rid: 4351267874930425966
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: How do you know that I'm here with you, anyway?
    ScreenActions:
    - rid: 4351267874930425967
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Especially since you're the only that notices, even when I don't say
      anything.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... huh!)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Well, that's because I can see <b>you</b>.)
    ScreenActions:
    - rid: 4351267874930425968
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Sorta...)
    ScreenActions:
    - rid: 4351267874930425969
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Obviously I can't see "<b>you</b>" you, because <b>you</b> aren't literally
      here...)
    ScreenActions:
    - rid: 4351267874930425970
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (But I <i>can</i> see something that accompanies <b>your</b>... view,
      I guess.)
    ScreenActions:
    - rid: 4351267874930425971
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (There's a faint image of a... blocky-pixely dragon that usually accompanies
      {mc}, but sometimes goes away for a time.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: '(Since that faint image showed up when <b>you</b> first talked to me,
      I figured that''s what you see out of.) '
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (And so far, I've been right!)
    ScreenActions:
    - rid: 4351267874930425972
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Which is kind of interesting, because that image wasn't a thing back
      home.)
    ScreenActions:
    - rid: 4351267874930425975
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (I wonder why you have an... icon, and why I <i>can</i> see it...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Maybe that story-obsessed <i>thing</i> gave it to you for me?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Not sure why though, <i>it</i> was pretty hell-bent on keeping me away
      from <b>you</b>...)
    ScreenActions:
    - rid: 4351267874930425976
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: ... for story reasons?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions:
    - rid: 4351267874930425977
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (So this is just some grand narrative, huh?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ({mc} becomes a dragon-slayer, and what?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (A polyamorous relationship between him, a bookworm, his childhood friend,
      and Ms. Daddy Issues?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: ... don't say that about Natsuki. And I don't think {mc} would be interested
      in that kind of relationship.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (And I get paired off with <b>you</b>?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (As much as I want that...)
    ScreenActions:
    - rid: 4351267874930425978
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (It just feels gross to be playing to the hand of some would-be director.)
    ScreenActions:
    - rid: 4351267874930425979
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: ... I don't know what to tell you...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... I wanna think about this. Alone.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Go hang out with {mc}, or the other girls, or whatever.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Uh... please take care of yourself, Monika.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... thanks.)
    ScreenActions:
    - rid: 4351267874930425980
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267874930426003
