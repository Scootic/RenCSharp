%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: TrainingArc1_Intro
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475098267418836
    - rid: 9079475098267418837
    - rid: 9079475089592287545
    - rid: 9079475110781911295
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions:
    - rid: 9079475098267418838
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Get up, {mc}!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Eh- wha-?
    ScreenActions:
    - rid: 9079475070362714200
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: We're about to have breakfast, get your lazy butt out of bed.
    ScreenActions:
    - rid: 9079475070362714201
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Natsuki, the hell are you doing in my house-
    ScreenActions:
    - rid: 9079475185789698048
  - speaker: {fileID: 0}
    dialog: Oh, wait...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Ah, right. Sorry.
    ScreenActions:
    - rid: 9079475185789698049
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'll be out in a few, give me some privacy while I get dressed.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, yeah, sure thing {mc}.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Natsuki leaves the room, letting me get dressed in peace.
    ScreenActions:
    - rid: 9079475185789698050
  - speaker: {fileID: 0}
    dialog: After getting dressed, I head out to the common area, where the girls
      are waiting for me.
    ScreenActions:
    - rid: 9079475185789698051
    - rid: 9079475206434586784
  - speaker: {fileID: 0}
    dialog: At one end of the table, Monika is enjoying some freshly fried eggs with
      a side of bread.
    ScreenActions:
    - rid: 9079475185789698052
  - speaker: {fileID: 0}
    dialog: Sayori, sitting next to her, has a plate of some sort of stew.
    ScreenActions:
    - rid: 9079475185789698053
  - speaker: {fileID: 0}
    dialog: It seems she hasn't really woken up yet...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Natsuki's plate only has crumbs left on it... I guess she must've woken
      up first.
    ScreenActions:
    - rid: 9079475185789698054
  - speaker: {fileID: 0}
    dialog: Rounding out the table, Yuri is starting off her day with some grilled
      leeks.
    ScreenActions:
    - rid: 9079475185789698055
  - speaker: {fileID: 0}
    dialog: ... what kind of breakfast is that?!?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I grab myself a plate of some salted beef roast and sit down with the
      girls.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So, {mc}...
    ScreenActions:
    - rid: 9079475185789698056
    - rid: 9079475185789698058
    - rid: 9079475185789698059
    - rid: 9079475185789698140
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: What's on the agenda for today?
    ScreenActions:
    - rid: 9079475185789698060
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: More main quest, I guess?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Oh, come on!
    ScreenActions:
    - rid: 9079475185789698061
    - rid: 9079475185789698067
    - rid: 9079475185789698068
    - rid: 9079475185789698069
  - speaker: {fileID: 0}
    dialog: Please tell me we aren't doing this again...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: It hasn't even been a day since we raided a dungeon and killed a dragon-
    ScreenActions:
    - rid: 9079475185789698062
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm still sore, and I'm pretty sure I've got a minor case of frostbite,
      and-
    ScreenActions:
    - rid: 9079475185789698063
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079475185789698064
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I'm sorry for being a jerk, but I just think we shouldn't go back into
      serious danger like that for a while.
    ScreenActions:
    - rid: 9079475185789698065
    - rid: 9079475185789698070
    - rid: 9079475185789698071
    - rid: 9079475185789698072
  - speaker: {fileID: 0}
    dialog: Oh.
    ScreenActions:
    - rid: 9079475185789698066
    - rid: 9079475185789698124
    - rid: 9079475185789698125
  - speaker: {fileID: 0}
    dialog: That's actually pretty reasonable...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I mean, what sort of stuff can we do here that's safe, anyway?
    ScreenActions:
    - rid: 9079475185789698126
  - speaker: {fileID: 0}
    dialog: Safe things to do?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: We could always waste around indoors, that's about as safe as we can
      get in Skyrim.
    ScreenActions:
    - rid: 9079475185789698127
    - rid: 9079475185789698128
    - rid: 9079475185789698129
    - rid: 9079475185789698130
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: But that wouldn't exactly solve our food insecurity...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Even if we were to all become subsistence farmers, or something...
    ScreenActions:
    - rid: 9079475185789698131
    - rid: 9079475185789698132
    - rid: 9079475185789698133
    - rid: 9079475185789698134
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: By the nature of this world being built for an Action RPG, there will
      always be some sort of life-threatening creature or person around the corner.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'Hell, Natsuki, you''re literally a bandit: walking proof that nowhere
      is <i>that</i> safe.'
    ScreenActions:
    - rid: 9079475185789698135
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ... I kinda forgot about that...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So I guess the safest thing to do, would be, somewhat paradoxically,
      to go into danger to get stronger.
    ScreenActions:
    - rid: 9079475185789698136
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Well, {mc}, what would be the safest way to get stronger, then?
    ScreenActions:
    - rid: 9079475185789698137
  - speaker: {fileID: 0}
    dialog: Hmm... that's a pretty good question.
    ScreenActions:
    - rid: 9079475185789698138
    - rid: 9079475185789698139
  - speaker: {fileID: 0}
    dialog: I guess skill-trainers come to mind first, since you don't have to get
      into literal life-or-death battle to improve...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: But they cost money that we really don't have.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Ah...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ... the guilds?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 'Yeah, the guilds are probably the safest way to become more powerful:'
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: They all give free board, which can decrease our expenditure, while giving
      us quests that come with free help.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Although, I don't know how strict our "end of the world" time table is
      compared to the original game...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, first, let's take a look at a map...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Wait a minute, do I even have a map?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I search my armor, finding a yellowed map in one of its folds.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I guess there was already a map inside?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I suppose that's a testament to my familiarity with this land; that I
      haven't needed to use this map so far...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Anyway, I pull the map out and place it on the table.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'So, this is the map of all of Skyrim, and we''re here:'
    ScreenActions:
    - rid: 9079475185789698142
  - speaker: {fileID: 0}
    dialog: I point toward the little dot that's labelled Riverwood.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Now, throughout Skyrim, there are four major guilds.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: There are the Companions in Whiterun, where we've already been.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: They're sort of like muscle-for-hire, but they like to claim that they
      have more honor than that.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Also, their high ranking members are all werewolves.
    ScreenActions:
    - rid: 9079475185789698141
    - rid: 9079475185789698143
    - rid: 9079475185789698144
    - rid: 9079475185789698146
    - rid: 9079475185789698147
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: W-werewolves?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yep, werewolves.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Moving on, in Riften-
    ScreenActions:
    - rid: 9079475185789698148
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: 'Are you seriously not gonna elaborate any further on the whole: "werewolves"
      thing?'
    ScreenActions:
    - rid: 9079475185789698149
    - rid: 9079475185789698150
    - rid: 9079475185789698151
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Nope! It's not like they prowl around at night stalking teenage girls,
      so they aren't anything to worry about.
    ScreenActions:
    - rid: 9079475185789698152
    - rid: 9079475185789698153
    - rid: 9079475185789698154
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Where was I again?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh right, Riften.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I point to the southeast, placing my finger on Riften.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Riften's home to the Thieves' Guild.
    ScreenActions:
    - rid: 9079475185789698155
    - rid: 9079475185789698156
    - rid: 9079475185789698157
    - rid: 9079475185789698158
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Thieves'... Guild?
    ScreenActions:
    - rid: 9079475185789698159
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yeah, Thieves' Guild. Are you guys seriously going to interrupt me every
      single time I speak?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Um... {mc}?
    ScreenActions:
    - rid: 9079475185789698160
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Oh my God! They really are going interrupt me <i>every</i> single time
      I speak!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Yuri, what did I just say?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: What you just said? Uhh... what do you mean?
    ScreenActions:
    - rid: 9079475185789698161
  - speaker: {fileID: 0}
    dialog: ... It seems everyone noticed except her.
    ScreenActions:
    - rid: 9079475185789698162
    - rid: 9079475185789698163
    - rid: 9079475185789698164
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Whatever. What is it Yuri? I'm <SineText=5>aaall</SineText> ears.
    ScreenActions:
    - rid: 9079475185789698165
    - rid: 9079475185789698166
    - rid: 9079475185789698167
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Well, it's just...
    ScreenActions:
    - rid: 9079475185789698168
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: The concept of a Thieves' Guild doesn't make much logical sense.
    ScreenActions:
    - rid: 9079475185789698169
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ... huh?
    ScreenActions:
    - rid: 9079475185789698170
    - rid: 9079475185789698171
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Well, if they are an organized group of thieves, operating specifically
      as a guild, wouldn't it be easy for law enforcement to just arrest all of them?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I mean, I guess... but what about, like, the real life mafia and yakuza
      and stuff?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Their organized crime usually integrates with corrupt government officials
      to keep running as long as they don't the shake the boat <i>too</i> much.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Riften's a pretty corrupt place, with high concentrations of wealth among
      a few, which is why the Thieves' Guild operates there.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Hmm...
    ScreenActions:
    - rid: 9079475185789698173
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: That's really interesting! Thank you, {mc}.
    ScreenActions:
    - rid: 9079475185789698172
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, yeah...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, the next guild is the Dark Brotherhood, which is headquarted
      in Falkreath.
    ScreenActions:
    - rid: 9079475185789698176
    - rid: 9079475185789698177
    - rid: 9079475185789698178
    - rid: 9079475185789698179
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: They're literally a bunch of assassins, and to join them you have to
      murder an old woman that runs an orphanage.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Sayori audibly gasps, and the other girls also seem startled.
    ScreenActions:
    - rid: 9079475185789698180
    - rid: 9079475185789698181
    - rid: 9079475185789698182
    - rid: 9079475185789698183
  - speaker: {fileID: 0}
    dialog: No one says anything though, breaking their interruption streak.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Nice.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: In their defense, that old woman had a bounty placed on her by one of
      the children she took care of for being a total bi-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Piece of work.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The final guild is the College of Winterhold, a school dedicated to the
      arcane arts.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: At this, Yuri seems to perk up.
    ScreenActions:
    - rid: 9079475185789698184
  - speaker: {fileID: 0}
    dialog: Natsuki and Monika seem to be intrigued by the concept.
    ScreenActions:
    - rid: 9079475185789698185
    - rid: 9079475185789698188
  - speaker: {fileID: 0}
    dialog: ... Sayori's still shell-shocked. I assume by the revelation of a child
      being able to put out a hit on some granny.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: There's still some baggage that comes with them, though.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The current college leadership isn't exactly... competent.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That, and the people of Skyrim have a complete and utter distaste for
      magic.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Seriously? How can you live in a world with magic and not want to abuse
      it?
    ScreenActions:
    - rid: 9079475185789698189
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I mean, it's kind of a cultural thing...
    ScreenActions:
    - rid: 9079475185789698190
    - rid: 9079475185789698191
    - rid: 9079475185789698192
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: See, the Nords of Skyrim are a very straight-forward people.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: They prefer direct conflict, the honor of simple labor and hard work,
      and magic isn't really about that.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: 'There was a time where Nord mages were respected as the "clevermen,"
      but after some... severe events magic has all but lost favor with the Nords
      as a people. '
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: For example, Winterhold used to be a major city of Skyrim, with a large
      population, until the majority of it collapsed into the sea many years ago.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: The College managed to survive this cataclysm, which has led many a Nord
      to blame them for the collapse.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Whether or not there's any truth to their claims doesn't really matter,
      the cultural damage has already been done.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So, yeah, those four guilds are probably the best bet to improve our
      skills and get accustomed to the world.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: 'So our choices are:'
    ScreenActions:
    - rid: 9079475206434586675
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Go become a thug for a bunch of werewolves...
    ScreenActions:
    - rid: 9079475206434586676
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Become a literal thief or murderer...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Or go to wizard school?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That about sums it up, yeah.
    ScreenActions:
    - rid: 9079475206434586677
    - rid: 9079475206434586679
    - rid: 9079475206434586680
    - rid: 9079475206434586683
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Technically, there's also a Bard's College, but they aren't nearly as...
      helpful.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: So, what should we do, {mc}?
    ScreenActions:
    - rid: 9079475206434586684
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I don't know?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I mean, I was laying out our options for <i>you</i> guys...
    ScreenActions:
    - rid: 9079475206434586685
    - rid: 9079475206434586686
    - rid: 9079475206434586687
    - rid: 9079475206434586688
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You know, so <i>you</i> can choose what <i>you</i> want to do?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: And so I don't have to be responsible for five whole people!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: That's four too many!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Um, what are you going to do, {mc}?
    ScreenActions:
    - rid: 9079475206434586689
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Me?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: None of those.
    ScreenActions:
    - rid: 9079475206434586690
    - rid: 9079475206434586691
    - rid: 9079475206434586692
    - rid: 9079475206434586693
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Huh?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm gonna go climb the Throat of the World and chat with the Graybeards.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: They did call for me yesterday, after all.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Which is part of the main quest that our dear Natsuki wanted nothing
      to do with.
    ScreenActions:
    - rid: 9079475206434586696
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: So... you're going without us?
    ScreenActions:
    - rid: 9079475206434586697
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That's your collective choice.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm going whether or not anyone else is.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Well, I don't mind sticking along with you, {mc}.
    ScreenActions:
    - rid: 9079475206434586698
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: I'm not really interested in getting involved with anything you just
      said, ahaha...
    ScreenActions:
    - rid: 9079475206434586699
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Um... I want to go to the College of Winterhold.
    ScreenActions:
    - rid: 9079475206434586700
    - rid: 9079475206434586701
  - speaker: {fileID: 0}
    dialog: ... of course <i>you</i> do...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I was going to suggest that you and Sayori go there, since the two of
      you are our magic users.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079475206434586702
  - speaker: {fileID: 0}
    dialog: Me thinks Sayori's worrying about me not having access to a healer while
      she's gone...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm going to be fine, Sayori.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: If worst comes to worst, I've got Monika at my back.
    ScreenActions:
    - rid: 9079475206434586703
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: If she can help you guys get through a bunch of traps in a dungeon without
      my help, the two of us together should be pretty formidable.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You just want an excuse to be alone with Monika, don't you?
    ScreenActions:
    - rid: 9079475206434586705
    - rid: 9079475206434586707
    - rid: 9079475206434586708
    - rid: 9079475206434586709
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Ahaha~... what?
    ScreenActions:
    - rid: 9079475206434586711
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: No? Why would I want to spend alone time with Monika?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Excuse me, {mc}?
    ScreenActions:
    - rid: 9079475206434586712
    - rid: 9079475206434586713
    - rid: 9079475206434586714
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh, that probably was a little rude...
    ScreenActions:
    - rid: 9079475206434586715
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sorry, Monika.
    ScreenActions:
    - rid: 9079475206434586716
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... whatever. It's <i>fine</i>, {mc}.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: '... is this one of those: "they say their fine, but they''re not actually
      fine," things?'
    ScreenActions:
    - rid: 9079475206434586717
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, what're you going to do, Natsuki?
    ScreenActions:
    - rid: 9079475206434586718
    - rid: 9079475206434586719
    - rid: 9079475206434586720
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I, uh...
    ScreenActions:
    - rid: 9079475206434586721
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Don't know.
    ScreenActions:
    - rid: 9079475206434586722
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, then I'll recommend joining the Companions.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: There's no way I'm going to be joining up with some werewolves-!
    ScreenActions:
    - rid: 9079475206434586723
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, not all of them are werewolves, only the inner circle.
    ScreenActions:
    - rid: 9079475206434586724
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Besides, I feel like you're the kind of person that would appreciate
      getting paid to beat people up.
    ScreenActions:
    - rid: 9079475206434586725
    - rid: 9079475206434586726
    - rid: 9079475206434586728
    - rid: 9079475206434586729
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: What's that supposed to mean?!?
    ScreenActions:
    - rid: 9079475206434586730
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That you seem to have a lot of pent-up aggression, that is better spent
      on someone other than me.
    ScreenActions:
    - rid: 9079475206434586731
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: '{mc}, you-!'
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I <i>was</i> going to slap you for that...
    ScreenActions:
    - rid: 9079475206434586732
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: But that would just give you the satisfaction of proving your point,
      wouldn't it?
    ScreenActions:
    - rid: 9079475206434586733
  - speaker: {fileID: 0}
    dialog: Careful, she's learning...!
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Heh.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Be that as it may, since you've been wielding a big warhammer, it'd probably
      best to hang out with that kind of crowd.
    ScreenActions:
    - rid: 9079475206434586785
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Do you <i>really</i> not want to join them, Natsuki?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 9079475206434586786
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Whatever, fine.
    ScreenActions:
    - rid: 9079475206434586787
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alrighty then, that's everybody sorted.
    ScreenActions:
    - rid: 9079475206434586788
    - rid: 9079475206434586789
    - rid: 9079475206434586791
    - rid: 9079475206434586792
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Is there some sort of way we can keep in contact with each other while
      we're doing our own thing?
    ScreenActions:
    - rid: 9079475206434586793
    - rid: 9079475206434586794
    - rid: 9079475206434586795
    - rid: 9079475206434586798
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: You know, since it looks like we're going to be spreading ourselves across
      a whole country...
    ScreenActions:
    - rid: 9079475206434586799
  - speaker: {fileID: 0}
    dialog: Huh.
    ScreenActions:
    - rid: 9079475206434586800
  - speaker: {fileID: 0}
    dialog: I hadn't thought of that...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, uh, there's a postage system here in Skyrim.
    ScreenActions:
    - rid: 9079475206434586801
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Obviously, there's going to be major delays for sending letters in a
      world that doesn't even have cars...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: But the couriers here are pretty dang persistent, notoriously so.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: So, not exactly a good way to be in constant communication, but could
      work for something like a daily update...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uhh...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Since the Graybeards were audible all the way up from High Hrothgar,
      maybe I can learn how to project my voice like that from them?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: There isn't really anything like that in the actual game, but I don't
      see why I can't ask them about it when I get up there...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Not that it would benefit you guys as much as it would me.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm pretty sure there are magical forms of telepathy and teleportation,
      so, Yuri, you could look into that if you find the time.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Hey, why not Yuri <i>and</i> me?
    ScreenActions:
    - rid: 9079475206434586802
    - rid: 9079475206434586803
    - rid: 9079475206434586804
    - rid: 9079475206434586805
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Sayori, you're on record as saying that Yuri's the smartest person in
      our club.
    ScreenActions:
    - rid: 9079475206434586806
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That's why.
    ScreenActions:
    - rid: 9079475206434586807
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, that's all I can really think of...
    ScreenActions:
    - rid: 9079475206434586808
    - rid: 9079475206434586809
    - rid: 9079475206434586810
    - rid: 9079475206434586811
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Hey, do <b>you</b> think <b>you</b> could help with that, somehow?)
    ScreenActions:
    - rid: 9079475206434586813
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Like, maybe pass messages along between us while we're far away?)
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475206434586814
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 9079475206434586815
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, Monika, what are you doing?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: Hmm? Nothing, just thinkin' about something.
    ScreenActions:
    - rid: 9079475206434586818
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Uh, right...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, we should stock up on food with what we have, and split up our
      septims before heading out.
    ScreenActions:
    - rid: 9079475206434586820
    - rid: 9079475206434586821
    - rid: 9079475206434586822
  - speaker: {fileID: 0}
    dialog: To know how much gold we really have, we dump all of it out onto the
      table.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Turns out, we've got [Gold] septims total.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: Divided by 5, that's...
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: An even split of 93 for each person, with one measly septim remaining.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: I elect to give it to Yuri, since the two of them are probably going
      to need to buy the spell needed to pursue higher education.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: We each spend about 40 of our hard-earned septims on food for the road,
      which should be enough to last a few days.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: With that, we begin our journey...
    ScreenActions:
    - rid: 9079475206434586823
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, this is where we're going to part ways, Natsuki.
    ScreenActions:
    - rid: 9079475206434586824
    - rid: 9079475206434586825
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: I know they're in Whiterun, but where exactly am I heading?
    ScreenActions:
    - rid: 9079475230094393395
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright, so once you enter the city, you're going to head straight until
      you reach the marketplace.
    ScreenActions:
    - rid: 9079475230094393396
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Once there, you take a left up the stairs toward the big tree.
    ScreenActions:
    - rid: 9079475230094393397
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Facing the big tree from there, Jorrvaskr, the upside-down boat-lookin'
      building, should be directly to your right.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: That's basically Companions HQ.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Once you get in there, you need to head downstairs to the basement level
      to a find an old man named Kodlak.
    ScreenActions:
    - rid: 9079475230094393398
    - rid: 9079475230094393399
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: He's the person you're going to talk to about joining.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: You get all that?
    ScreenActions:
    - rid: 9079475230094393401
    - rid: 9079475230094393402
    - rid: 9079475230094393403
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, I got it.
    ScreenActions:
    - rid: 9079475230094393400
    - rid: 9079475230094393404
    - rid: 9079475230094393405
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: See you guys later.
    ScreenActions:
    - rid: 9079475230094393406
  - speaker: {fileID: 0}
    dialog: Natsuki takes the left toward Whiterun.
    ScreenActions:
    - rid: 9079475230094393407
    - rid: 9079475230094393408
    - rid: 9079475230094393409
    - rid: 9079475230094393410
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Stay safe, Natsuki!
    ScreenActions:
    - rid: 9079475230094393411
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Yeah, yeah, I will!
    ScreenActions:
    - rid: 9079475230094393412
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Alright fellas, let's get moving.
    ScreenActions:
    - rid: 9079475230094393413
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
  playerChoices:
  - choiceText: 
    resultingSequence: {fileID: 11400000, guid: edbcfdac941e57e449b2578c829944b0, type: 2}
    conditions: []
