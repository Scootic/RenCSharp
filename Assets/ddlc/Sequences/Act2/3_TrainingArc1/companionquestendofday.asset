%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: companionquestendofday
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351268081624678529
    - rid: 4351268081624678530
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: ... This woman has endured, has challenged, and has shown her valor.
      Who will speak for her?
    ScreenActions:
    - rid: 4351268081624678531
    - rid: 4351268081624678532
    - rid: 4351268081624678533
    - rid: 4351268081624678534
    - rid: 4351268081624678535
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I stand witness to the courage of the soul before us.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Would you raise your shield in her defense?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I would stand at her back, that the world might never overtake us.
    ScreenActions:
    - rid: 4351268081624678536
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: And would you raise your sword in her honor?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: It stands ready to meet the blood of her foes.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: And would you raise a mug in her name?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: I would lead the song of triumph as our mead hall reveled in her stories.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Then the judgement of this Circle is complete.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Her heart beats with the fury and courage that have united the Companions
      since the days of distant green summers.
    ScreenActions:
    - rid: 4351268081624678537
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Let it beat with ours, that the mountains may echo and our enemies tremble
      at the call.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 19994ba39eb37754eb26e44446994a72, type: 2}
    dialog: It shall be so.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: db46f9c9f9769b944946c389f5c0fbec, type: 2}
    dialog: It shall be so.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb5b825b0be0b62428004be39a77cc24, type: 2}
    dialog: Well, you're one of us now. I trust you won't disappoint.
    ScreenActions:
    - rid: 4351268081624678538
    - rid: 4351268081624678539
    - rid: 4351268081624678540
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351268081624678541
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: You don't seem very happy about joining.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Did you not want to?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Huh?
    ScreenActions:
    - rid: 4351268081624678542
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Oh, well, that's not it, I just-
    ScreenActions:
    - rid: 4351268081624678543
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: This is only the second time I've felt like I was actually wanted somewhere
      in a long while.
    ScreenActions:
    - rid: 4351268081624678545
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: Thanks, by the way.
    ScreenActions:
    - rid: 4351268081624678547
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Uh, yeah.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17bd3b6fcae930647918fc183fea836b, type: 2}
    dialog: Well, like Kodlak said, welcome to the Companions.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351268081624678548
  - speaker: {fileID: 11400000, guid: 9f0072f96d4dfc24f9477258c07882f5, type: 2}
    dialog: (It's getting pretty late, I should head to bed...)
    ScreenActions:
    - rid: 4351268081624678550
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions: []
