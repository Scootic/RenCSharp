%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: collegequest2WEIRDROUTE
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Hey, Yuri.
    ScreenActions:
    - rid: 4351267964947792048
    - rid: 4351267964947792049
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Who is that?!?
    ScreenActions:
    - rid: 4351267964947792050
    - rid: 4351267964947792051
    - rid: 4351267964947792068
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri, did you hear something-?
    ScreenActions:
    - rid: 4351267964947792067
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Hush, don't panic. Take a deep breath, Yuri.
    ScreenActions:
    - rid: 4351267964947792076
    - rid: 4351267964947792077
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Breathe in...
    ScreenActions:
    - rid: 4351267964947792078
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: And out...
    ScreenActions:
    - rid: 4351267964947792079
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Good.
    ScreenActions:
    - rid: 4351267964947792080
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: 'Before you say anything: don''t. Think your thought instead.'
    ScreenActions:
    - rid: 4351267964947792081
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (So you can read my thoughts?)
    ScreenActions:
    - rid: 4351267964947792082
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Only sometimes.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (Who are you- what do you want?!?)
    ScreenActions:
    - rid: 4351267964947792083
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: ... who I am?
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947792084
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947792085
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947792086
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947792087
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: I want to help you and Sayori, Yuri.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: As in, help you get out of the room you're trapped in.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Nothing to be worried about!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Or, at the very least I assume you're worried, anyway...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (So, uh...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (What do we do?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: Well, you're definitely going to need that amulet that's lying on the
      floor.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 99c1c9ab1bd810549a65874b102351c3, type: 2}
    dialog: You're going to put it on, and then cast a spell on the door.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: (...)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri follows <b>your</b> instructions, reaching down and putting on the
      amulet.
    ScreenActions:
    - rid: 4351267964947792088
    - rid: 4351267964947792089
    - rid: 4351267964947792090
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Yuri then spews a continuous burst of flames from her hands at the wall,
      which shatters it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: ... but the only spell Yuri knew was Bound Dagger...?
    ScreenActions:
    - rid: 4351267964947792091
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: I'm not sure what to expect here, be on your guard.
    ScreenActions:
    - rid: 4351267964947792092
    - rid: 4351267964947792093
    - rid: 4351267964947792094
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Huh, what-?
    ScreenActions:
    - rid: 4351267964947792095
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Sayori, did you do something to take care of the wall?
    ScreenActions:
    - rid: 4351267964947792096
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: No... Yuri, you don't remember spewing fire at that wall?
    ScreenActions:
    - rid: 4351267964947792098
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Uh, no? I wouldn't know how to do that even if I wanted to, Sayori.
    ScreenActions:
    - rid: 4351267964947792099
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267964947792100
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947792101
    - rid: 4351267964947792116
