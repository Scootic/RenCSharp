%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: collegequest2
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947791970
    - rid: 4351267964947791971
    - rid: 4351267964947791972
    - rid: 4351267964947791973
    - rid: 4351267964947791974
    - rid: 4351267964947791975
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I'm sorry for interrupting your question earlier, Yuri.
    ScreenActions:
    - rid: 4351267964947791976
    - rid: 4351267964947791977
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: You seemed a little <i>too</i> into the whole "Night of Tears" thing...
    ScreenActions:
    - rid: 4351267964947791978
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Oh, it's alright Sayori.
    ScreenActions:
    - rid: 4351267964947791983
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: We're here to do something, after all-
    ScreenActions:
    - rid: 4351267964947791986
    - rid: 4351267964947791987
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: And I probably would've kept asking questions until it would be time
      to leave...
    ScreenActions:
    - rid: 4351267964947791988
    - rid: 4351267964947791989
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267964947791990
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Excuse me, are you Arniel Gane?
    ScreenActions:
    - rid: 4351267964947791991
    - rid: 4351267964947791992
    - rid: 4351267964947791993
    - rid: 4351267964947791995
    - rid: 4351267964947791996
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: Ah, yes. Who are you people?
    ScreenActions:
    - rid: 4351267964947791997
    - rid: 4351267964947791998
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Uh, Mr. Tolfdir sent us to help you...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: What? You're going to help?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: That's fine, just-
    ScreenActions:
    - rid: 4351267964947791999
    - rid: 4351267964947792000
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: Just don't make a mess of my work.
    ScreenActions:
    - rid: 4351267964947792001
    - rid: 4351267964947792002
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: I've only looked through a portion of this section, so you, uh, can look
      around in the chambers north of here.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bb9f828e52d514c40abf34b5b4c668c4, type: 2}
    dialog: Try and be careful, alright? We don't want to damage anything.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: ... yeah, okay...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The two of them turn to their right, moving forward into the ruins.
    ScreenActions:
    - rid: 4351267964947792003
    - rid: 4351267964947792004
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: As if we'd break anything-!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267964947792005
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ... we, Sayori?
    ScreenActions:
    - rid: 4351267964947792006
    - rid: 4351267964947792007
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri! That's mean!
    ScreenActions:
    - rid: 4351267964947792008
    - rid: 4351267964947792009
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: But not inaccurate...
    ScreenActions:
    - rid: 4351267964947792010
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Despite being upset, Sayori looks around carefully for anything shiny
      or otherwise out of the ordinary.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Ooh, a ring!
    ScreenActions:
    - rid: 4351267964947792011
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri, Yuri, I found a ring!
    ScreenActions:
    - rid: 4351267964947792012
    - rid: 4351267964947792013
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Is there something special about it?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I dunno...
    ScreenActions:
    - rid: 4351267964947792014
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Let's find out!
    ScreenActions:
    - rid: 4351267964947792015
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Uh, Sayori how are you going to-?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori slips the ring onto her ring finger.
    ScreenActions:
    - rid: 4351267964947792018
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ...
    ScreenActions:
    - rid: 4351267964947792019
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: ...!
    ScreenActions:
    - rid: 4351267964947792017
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Sayori, are you okay?!? Is that ring cursed?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Nah, I'm okay.
    ScreenActions:
    - rid: 4351267964947792020
    - rid: 4351267964947792021
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Actually, I feel kinda good, like I've got a bit more energy than usual!
    ScreenActions:
    - rid: 4351267964947792022
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Maybe we shouldn't put on the magical artifacts to test their effects...
      it could be dangerous.
    ScreenActions:
    - rid: 4351267964947792023
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: The two of them continue looking for magical artifacts, finding three
      more enchanted rings.
    ScreenActions:
    - rid: 4351267964947792024
    - rid: 4351267964947792025
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Look Yuri, there's a weird amulet up on that wall.
    ScreenActions:
    - rid: 4351267964947792026
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: So there is-
    ScreenActions:
    - rid: 4351267964947792027
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori picks up the amulet, which causes the passageway behind them to
      close off.
    ScreenActions:
    - rid: 4351267964947792028
    - rid: 4351267964947792029
    - rid: 4351267964947792030
    - rid: 4351267964947792031
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Sayori, put it back!
    ScreenActions:
    - rid: 4351267964947792032
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori tries to put the amulet back where she got it, but the passageway
      remains sealed.
    ScreenActions:
    - rid: 4351267964947792033
    - rid: 4351267964947792034
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Yuri, what do we do?!?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: What in the world was that racket! Everything alright?
    ScreenActions:
    - rid: 4351267964947792035
    - rid: 4351267964947792036
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: I picked up a weird amulet and now we're trapped in here!
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: What should we do, Mr. Tolfdir?
    ScreenActions:
    - rid: 4351267964947792037
  - speaker: {fileID: 11400000, guid: f2b4d7673734a1a43a263468a2605a5c, type: 2}
    dialog: Hm. Perhaps the amulet is important somehow...? See if you can't use
      it in some way.
    ScreenActions:
    - rid: 4351267964947792038
    - rid: 4351267964947792039
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Use it in some way...?
    ScreenActions:
    - rid: 4351267964947792040
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Sayori throws the amulet at the wall.
    ScreenActions:
    - rid: 4351267964947792041
    - rid: 4351267964947792042
    - rid: 4351267964947792043
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 639d4037fbc3acd41947392e6542aac6, type: 2}
    dialog: Nothing happens.
    ScreenActions:
    - rid: 4351267964947792044
    - rid: 4351267964947792045
  - speaker: {fileID: 11400000, guid: bd43d09d02697ee489059e7390a0597d, type: 2}
    dialog: Dang it...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 294377bcfa9c68d468fbdb53f597dc39, type: 2}
    dialog: Uuhhh...
    ScreenActions:
    - rid: 4351267964947792047
  playerChoices:
  - choiceText: Intervene.
    resultingSequence: {fileID: 11400000, guid: acd6c190ea758bb49891a100c0db7834, type: 2}
    requireCondition: 0
    conditions: []
  - choiceText: Let them figure it out.
    resultingSequence: {fileID: 11400000, guid: 1cf5d0def9a5e01488956939f79ad2ef, type: 2}
    requireCondition: 0
    conditions: []
