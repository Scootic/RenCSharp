%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca23d3e41cd5424c9ec72c610ef25a4, type: 3}
  m_Name: HighHrothgar
  m_EditorClassIdentifier: 
  autoFocusSpeaker: 1
  screens:
  - speaker: {fileID: 0}
    dialog: I place the supplies I got from Klimmek into the offering chest, as the
      two of us enter High Hrothgar.
    ScreenActions: []
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267851529093237
    - rid: 4351267851529093238
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: ... wow...
    ScreenActions:
    - rid: 4351267851529093239
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: You can really feel how ancient this place is just by being here...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm with ya, Monika.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: So... a dragonborn appears, at this moment in the turning of the age.
    ScreenActions:
    - rid: 4351267874930425907
    - rid: 4351267874930425908
    - rid: 4351267874930425909
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Oh, hey Arngeir. How's Paarthurnax these days?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: ... how do you know about him?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: I'm cultured, you don't need to worry about it.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Anyway, aren't you going to ask me to shout at you, or something?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... what?)
    ScreenActions:
    - rid: 4351267874930425910
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (To prove that I'm actually dragonborn, Monika.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Oh, that makes more sense.)
    ScreenActions:
    - rid: 4351267874930425911
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: Of course. Let us taste your voice.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: <font=dragonfont>fus</font>!
    ScreenActions:
    - rid: 4351267874930425914
    - rid: 4351267874930425915
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: Dragonborn, it is you. Welcome to High Hrothgar.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: I speak for the Graybeards. Now tell me, Dragonborn-
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: My name is {mc}.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: ...
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: Tell me, {mc}, why have you come here?
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Well, you're the ones who called me up, so I figured you wanted to see
      me.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: Besides from that, I would like to learn about the Way of the Voice.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: We will do our best to teach you how to use your gift in fulfillment
      of your destiny.
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Destiny?)
    ScreenActions:
    - rid: 4351267874930425917
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (To defeat a dragon called Alduin. Probably.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (... so you're a hero of prophecy now?)
    ScreenActions:
    - rid: 4351267874930425918
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Yeah?)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Try not to get too big of a head, {mc}.)
    ScreenActions:
    - rid: 4351267874930425919
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (I wasn't planning on being a jerk about it...)
    ScreenActions:
    - rid: 4351267874930425920
  - speaker: {fileID: 11400000, guid: 17d7fb6524a48624b8f800e8b355e0ad, type: 2}
    dialog: Without training, you have already taken the first steps towards projecting
      your voice into a Thu'um, a shout. Now, let us see...
    ScreenActions:
    - rid: 4351267874930425921
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (Yeah, these guys are just going to teach me the next bits of the shout
      that made me hit my head in Bleak Falls Barrow.)
    ScreenActions:
    - rid: 4351267874930425922
  - speaker: {fileID: 11400000, guid: 905407d7a8ed6004ebfd47e9529ecf8c, type: 2}
    dialog: (It's probably not going to be too interesting for you, so you can look
      around or do something else, if you want.)
    ScreenActions: []
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Oh, sure {mc}.)
    ScreenActions:
    - rid: 4351267874930425923
  - speaker: {fileID: 0}
    dialog: Monika starts exploring High Hrothgar, while I receive my lecture.
    ScreenActions:
    - rid: 4351267874930425924
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267874930425925
    - rid: 4351267874930425926
    - rid: 4351267874930425928
  - speaker: {fileID: 11400000, guid: bcc4aa0537be91d488c1075e0cd8d29a, type: 2}
    dialog: (Hi again!)
    ScreenActions:
    - rid: 4351267874930425927
  - speaker: {fileID: 0}
    dialog: 
    ScreenActions:
    - rid: 4351267874930425929
